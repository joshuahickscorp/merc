{
  "schema_version": 1,
  "surface_discovery": {
    "patterns": [
      "*.md",
      "docs/*.md",
      "*/README.md",
      "*/*/README.md",
      "web/*.html",
      "web/**/*.md",
      "scripts/*.sh"
    ],
    "ignored_prefixes": [
      ".claude/",
      ".pytest_cache/",
      "agent/vendor/",
      "docs/legal/"
    ]
  },
  "active_surfaces": [
    "README.md",
    "clients/cli/README.md",
    "docs/QUICKSTART.md",
    "docs/RUNBOOKS.md",
    "docs/RUNTIME_MATRIX.md",
    "docs/SECURITY.md",
    "ops/monitoring/README.md",
    "scripts/install.sh",
    "web/admin.html",
    "web/index.html"
  ],
  "capability_checks": {
    "macos_menu_bar_requires_package_swift": {
      "surfaces": [
        "web/index.html",
        "scripts/install.sh"
      ],
      "claim_patterns": [
        "(?i)macOS menu bar app builds today",
        "(?i)macOS menu bar app are optional layers",
        "(?i)buyer CLI and macOS menu bar app",
        "(?i)swift build --package-path clients/macapp"
      ],
      "required_path": "clients/macapp/ComputeExchangeAgent/Package.swift"
    },
    "embeddings_price_matches_boot_reprice": {
      "surface": "web/index.html",
      "price_pattern": "embeddings[\\s\\S]{0,400}?\\$([0-9]+(?:\\.[0-9]+)?)",
      "model_id": "all-minilm-l6-v2",
      "source": "control/pricing.go RepriceCatalogueFromSupplierEconomics at boot (control/main.go ApplyRepricing)"
    }
  }
}
