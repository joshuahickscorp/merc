# Copy to the repository root as .env.go-closure, fill it through the approved
# secret channel, and chmod 600. This template contains no working credentials.

# Exact external inputs are declared in ops/go-closure-inputs.json.
STAGING_SSH_TARGET=deploy-user@staging.example.invalid
STAGING_TLS_HOSTNAME=canary.example.invalid
STAGING_DEPLOYMENT_ROOT=/srv/computexchange-go-closure
MERC_BACKUP_OFFSITE=s3://private-staging-backups/computexchange
AWS_ACCESS_KEY_ID=REPLACE_VIA_SECRET_CHANNEL
AWS_SECRET_ACCESS_KEY=REPLACE_VIA_SECRET_CHANNEL
MERC_BACKUP_ENCRYPTION_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
MERC_BACKUP_DECRYPTION_IDENTITY_FILE=/secure/path/staging-backup-identity.txt
STRIPE_SECRET_KEY=sk_test_REPLACE_VIA_SECRET_CHANNEL
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_VIA_SECRET_CHANNEL
MERC_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_WITH_DISTINCT_SECRET
MERC_CONNECT_CLIENT_ID=ca_REPLACE_WITH_TEST_PLATFORM_ID
STRIPE_TEST_CONNECTED_ACCOUNT_ID=acct_REPLACE_WITH_CANADIAN_TEST_ACCOUNT
STRIPE_BILLING_WEBHOOK_ENDPOINT_ID=we_REPLACE_WITH_TEST_BILLING_ENDPOINT
STRIPE_CONNECT_WEBHOOK_ENDPOINT_ID=we_REPLACE_WITH_TEST_CONNECT_ENDPOINT
# The reviewed Level B manifest fixes MERC_PAYMENT_MODE=test,
# MERC_PAYMENT_PROVIDER=stripe, and MERC_SETTLEMENT_CURRENCY=cad. Do not
# override them here; the connected account and both endpoint IDs above are
# validated against that candidate authority. Live value remains prohibited.
# The price board is USD-denominated. Supply a reviewed CAD-per-USD rate and a
# source/revision that can be audited later; neither value is invented here.
MERC_PRICE_REFERENCE_TO_SETTLEMENT_RATE=REPLACE_WITH_APPROVED_CAD_PER_USD_RATE
MERC_PRICE_FX_REVISION=REPLACE_WITH_IMMUTABLE_SOURCE_REVISION
ALERT_RECEIVER_WEBHOOK_URL=https://receiver.example.invalid/private-path
ALERT_RECEIVER_NAME=REPLACE_WITH_RECEIVER_NAME

# Immutable release outputs. Every image value must contain @sha256:<64 hex>.
MERC_CANDIDATE_CONTROL_IMAGE=ghcr.io/OWNER/computexchange-control@sha256:REPLACE_64_HEX
MERC_CANDIDATE_COMMIT=REPLACE_40_HEX
MERC_PRIOR_CONTROL_IMAGE=ghcr.io/OWNER/computexchange-control@sha256:REPLACE_64_HEX
MERC_PRIOR_COMMIT=REPLACE_40_HEX
MERC_PROMETHEUS_IMAGE=quay.io/prometheus/prometheus@sha256:REPLACE_64_HEX
MERC_ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager@sha256:REPLACE_64_HEX
MERC_GRAFANA_IMAGE=docker.io/grafana/grafana@sha256:REPLACE_64_HEX
MERC_NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter@sha256:REPLACE_64_HEX

# Persistent TLS and application secrets/configuration.
STAGING_STORAGE_TLS_HOSTNAME=storage.canary.example.invalid
STAGING_BIND_ADDRESS=192.0.2.10
ACME_EMAIL=staging-operator@example.invalid
POSTGRES_PASSWORD=REPLACE_VIA_SECRET_CHANNEL
MINIO_ROOT_USER=REPLACE_VIA_SECRET_CHANNEL
MINIO_ROOT_PASSWORD=REPLACE_VIA_SECRET_CHANNEL
GF_SECURITY_ADMIN_PASSWORD=REPLACE_VIA_SECRET_CHANNEL
MERC_TOKEN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MERC_VERIFICATION_SAMPLE_SECRET=REPLACE_WITH_DISTINCT_32_RANDOM_BYTES

# The compose manifest fixes the reviewed economic schedule and every canary
# ceiling. Only the two project-controlled participant allowlists are external.
MERC_CANARY_APPROVED_BUYER_EMAILS=buyer-one@example.invalid,buyer-two@example.invalid
MERC_CANARY_APPROVED_WORKER_IDS=REPLACE_UUID_ONE,REPLACE_UUID_TWO
MERC_CANARY_APPROVED_AGENT_VERSIONS=REPLACE_REVIEWED_SEMVER
# Must include the sealed r6 infer identity 7cc01c442c7f6dbe (see
# ops/staging/alpha-participants.json). Do not list only the superseded r5
# hash f4303a751ca2b2af.
MERC_CANARY_APPROVED_BUILD_HASHES=7cc01c442c7f6dbe

# Rehearsal adapters. Use physical canonical paths to project-controlled,
# non-symlink, non-group/world-writable executables in non-group/world-writable
# directories. The canary driver must implement the exact-run schema-v2 receipt
# contract in ops/staging/README.md; its SHA-256 is frozen for each run.
MERC_CANARY_SCENARIO_DRIVER=/srv/computexchange-drivers/canary-scenario-driver
MERC_CANARY_APPROVED_DRIVER_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_REVIEWED_DRIVER_SHA256
MERC_AGENT_RESTART_DRIVER=/srv/computexchange-drivers/agent-restart-driver
MERC_AGENT_RESTART_APPROVED_DRIVER_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_REVIEWED_DRIVER_SHA256

# Optional bounded thresholds.
MERC_SOAK_MAX_RSS_GROWTH_BYTES=134217728
MERC_SOAK_MAX_DISK_GROWTH_KB=1048576
MERC_REHEARSAL_NETWORK_INTERRUPTION_SECONDS=5
