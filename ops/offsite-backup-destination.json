{
  "schema_version": 1,
  "kind": "offsite_backup_destination",
  "status": "CONFIGURED",
  "provider": "cloudflare_r2",
  "endpoint_kind": "s3_compatible",
  "credential_source": "gitignored .merc-secrets.env R2_* keys, mapped to MERC_BACKUP_* / AWS_* by ops/scripts/offsite-independent-restore.sh",
  "prefix_policy": "s3://<R2_BUCKET>/offsite-alpha/<backup_id>",
  "independence_boundary": "cloudflare_r2_operator_controlled",
  "operator_controlled": true,
  "paid_resource_created_this_rehearsal": false,
  "live_droplet_volume_is_source": true,
  "secret_values_recorded": false,
  "repeatable_command": "make offsite-droplet-restore",
  "check_command": "make offsite-droplet-restore-check",
  "isolated_rehearsal_command": "make offsite-independent-restore"
}
