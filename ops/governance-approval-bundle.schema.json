{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercmerc.invalid/schemas/governance-approval-bundle.schema.json",
  "title": "merc exact-candidate governance approval bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_commit", "scope", "approvals", "exercises"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"const": "supervised_stripe_test_mode_private_canary"},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "privacy", "legal", "licensing", "payments", "operations", "supplier_policy", "release_approval"],
      "properties": {
        "security": {"$ref": "#/$defs/approval"},
        "privacy": {"$ref": "#/$defs/approval"},
        "legal": {"$ref": "#/$defs/approval"},
        "licensing": {"$ref": "#/$defs/approval"},
        "payments": {"$ref": "#/$defs/approval"},
        "operations": {"$ref": "#/$defs/approval"},
        "supplier_policy": {"$ref": "#/$defs/approval"},
        "release_approval": {"$ref": "#/$defs/approval"}
      }
    },
    "exercises": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_tabletop", "security_tabletop", "dsar_export_deletion", "backup_tombstone", "asset_and_model_provenance"],
      "properties": {
        "support_tabletop": {"$ref": "#/$defs/exercise"},
        "security_tabletop": {"$ref": "#/$defs/exercise"},
        "dsar_export_deletion": {"$ref": "#/$defs/exercise"},
        "backup_tombstone": {"$ref": "#/$defs/exercise"},
        "asset_and_model_provenance": {"$ref": "#/$defs/exercise"}
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver", "organization", "reviewed_scope", "evidence_uri", "approved_at"],
      "properties": {
        "status": {"const": "APPROVED"},
        "approver": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
        "organization": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
        "reviewed_scope": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:.*\\S)?$"},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
        "approved_at": {"type": "string", "maxLength": 20, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_uri", "completed_at"],
      "properties": {
        "status": {"const": "PASS"},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
        "completed_at": {"type": "string", "maxLength": 20, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    }
  }
}
