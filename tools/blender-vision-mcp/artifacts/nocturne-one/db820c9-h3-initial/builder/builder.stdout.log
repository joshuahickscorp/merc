for_function(\n  1047\t                \"() => ['3d_ready','3d_unavailable'].includes(__NOCTURNE__.state)\"\n  1048\t            )\n  1049\t            mobile_frames = [\n  1050\t                float(value)\n  1051\t                for value in mobile_page.evaluate(\n  1052\t                    \"(count) => __NOCTURNE__.sampleFrames(count)\",\n  1053\t                    int(self.contract.performance_budget[\"frame_sample_count\"]),\n  1054\t                )\n  1055\t            ]\n  1056\t            mobile_median_fps = 1000 / statistics.median(mobile_frames)\n  1057\t            mobile_p95 = _percentile(mobile_frames, 0.95)\n  1058\t            hidden_trace_result = self._execute_hidden_trace(\n  1059\t                mobile_page, origin, hidden_trace\n  1060\t            )\n  1061\t            observed_states.update(\n  1062\t                mobile_page.evaluate(\"() => __NOCTURNE__.stateHistory\")\n  1063\t            )\n  1064\t            mobile_overflow = bool(\n  1065\t                mobile_page.evaluate(\n  1066\t                    \"\"\"() => document.documentElement.scrollWidth\n  1067\t                      > document.documentElement.clientWidth + 1\"\"\"\n  1068\t                )\n  1069\t            )\n  1070\t            mobile_context.close()\n  1071\t            scenario_context = browser.new_context(\n  1072\t                viewport={\"width\": 900, \"height\": 760},\n  1073\t                color_scheme=\"dark\",\n  1074\t            )\n  1075\t            scenario_page = scenario_context.new_page()\n  1076\t            scenario_page.goto(f\"{origin}/\", wait_until=\"networkidle\")\n  1077\t            scenario_page.evaluate(\n  1078\t                \"() => __NOCTURNE__.setTestCondition('slow_network')\"\n  1079\t            )\n  1080\t            scenario_page.locator(\"#enter-3d\").click()\n  1081\t            scenario_page.wait_for_function(\n  1082\t                \"() => __NOCTURNE__.state === 'slow_network'\"\n  1083\t            )\n