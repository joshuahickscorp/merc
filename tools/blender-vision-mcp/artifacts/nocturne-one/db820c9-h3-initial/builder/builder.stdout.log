untime_probe_controls\",\n1471:                performance[\"critical_html_css_transfer_bytes\"],\n1472:                performance[\"critical_html_css_transfer_bytes\"]\n1478:                performance[\"initial_javascript_transfer_bytes\"],\n1479:                performance[\"initial_javascript_transfer_bytes\"]\n1489:                    \"hero\": performance[\"hero_glb_bytes\"],\n1490:                    \"mobile_lod\": performance[\"mobile_lod_glb_bytes\"],\n1492:                performance[\"hero_glb_bytes\"]\n1494:                and performance[\"mobile_lod_glb_bytes\"]\n1501:                performance[\"cumulative_layout_shift\"],\n1502:                performance[\"cumulative_layout_shift\"]\n1512:                    \"median_fps\": performance[\"desktop_median_fps\"],\n1513:                    \"p95_ms\": performance[\"desktop_frame_p95_ms\"],\n1515:                performance[\"desktop_median_fps\"]\n1517:                and performance[\"desktop_frame_p95_ms\"]\n1527:                    \"median_fps\": performance[\"mobile_median_fps\"],\n1528:                    \"p95_ms\": performance[\"mobile_frame_p95_ms\"],\n1530:                performance[\"mobile_median_fps\"]\n1532:                and performance[\"mobile_frame_p95_ms\"]\n1542:                    \"duration_seconds\": performance[\"memory_duration_seconds\"],\n1543:                    \"growth_bytes\": performance[\"memory_growth_bytes\"],\n1544:                    \"sample_count\": len(performance[\"memory_samples_bytes\"]),\n1546:                performance[\"memory_duration_seconds\"]\n1548:                and performance[\"memory_growth_bytes\"]\n   300\t            CandidateFile(\n   301\t                path=path.relative_to(root).as_posix(),\n   302\t                sha256=digest,\n   303\t                size=size,\n   304\t            )\n   305\t        )\n   306\t    receipt = NocturneCandidateBuildReceipt(\n   307\t        benchmark_id=contract.benchmark_id,\n   308\t        authority=\"VISIONMCP_BUILDER_OUTPUT\",\n   309\t        contract_sha256=sha256_file(resolved_contract)[0],\n   310\t        packet_manifest_sha256=packet_verification[\"packet_manifest_sha256\"],\n   311\t        builder_condition=builder_condition,\n   312\t        generated_at=utc_now(),\n   313\t        files=files,\n   314\t        attempts=attempt_records,\n   315\t        reproduction_commands=[\n   316\t            \"npm ci\",\n   317\t            \"npm run verify\",\n   318\t            \"npm run db:migrate\",\n   319\t            \"npm run db:rollback\",\n   320\t            \"npm start\",\n   321\t        ],\n   322\t        manual_edits_outside_receipt_chain=False,\n   323\t        oracle_source_access=False,\n   324\t    )\n   325\t    atomic_write_json(receipt_path, receipt.model_dump(mode=\"json\"))\n   326\t    return receipt\n   327\t\n   328\t\n   329\tclass NocturneAppEvaluator:\n   330\t    def __init__(self, contract_path: Path | None = None):\n   331\t        self.contract, self.contract_path = load_nocturne_contract(contract_path)\n   332\t\n   333\t    def run(\n   334\t        self,\n   335\t        *,\n   336\t        packet_root: Path,\n   337\t        candidate_root: Path,\n   338\t        sealed_builder_receipt_path: Path,\n   339\t        hidden_mobile_trace_path: Path,\n   340\t        output_root: Path,\n   341\t    ) -> NocturneAppReceipt:\n   342\t        packet = packet_root.expanduser().resolve()\n   343\t        candidate = candidate_root.expanduser().resolve()\n   344\t        output = output_root.expanduser().resolve()\n   345\t        if output.exists() and any(output.iterdir()):\n   346\t            raise NocturneAppEvaluationError(\"app evaluator output must be new or empty\")\n   347\t        output.mkdir(parents=True, exist_ok=True)\n   348\t        packet_verification = NocturnePacketAuthority(self.contract_path).verify(packet)\n   349\t        sealed_receipt_path = sealed_builder_receipt_path.expanduser().resolve()\n   350\t        sealed_receipt = SealedBuilderReceipt.model_validate_json(\n   351\t            sealed_receipt_path.read_text(encoding=\"utf-8\")\n   352\t        )\n   353\t        contract_digest = sha256_file(self.contract_path)[0]\n   354\t        if (\n   355\t            sealed_receipt.status != \"PASS\"\n   356\t            or sealed_receipt.contract_sha256 != contract_digest\n   357\t        ):\n   358\t            raise SecurityError(\"app evaluation requires a matching sealed builder receipt\")\n   359\t        build_receipt, candidate_verification = NocturneCandidateAuthority(\n   360\t            self.contract_path\n   361\t        ).verify(\n   362\t            candidate,\n   363\t            packet_manifest_sha256=packet_verification[\"packet_manifest_sha256\"],\n   364\t        )\n   365\t        source_head = code_revision(Path(__file__).resolve().parents[3])\n   366\t        if len(source_head) != 40:\n   367\t            raise NocturneAppEvaluationError(\n   368\t                \"app evaluation requires a full Git source revision\"\n   369\t            )\n   370\t        started_at = datetime.now(UTC).isoformat()\n   371\t        started = time.monotonic()\n   372\t        assertions: list[AppAssertion] = []\n   373\t        commands: list[CommandReceipt] = []\n   374\t        api: dict[str, Any] = {}\n   375\t        browser: dict[str, Any] = {}\n   376\t        performance: dict[str, Any] = {}\n   377\t        accessibility: dict[str, Any] = {}\n   378\t        runtime: dict[str, Any] = {}\n   379\t        output_digests: dict[str, str] = {}\n   380\t        failure: str | None = None\n   381\t        server: subprocess.Popen[str] | None = None\n   382\t        try:\n   383\t            fresh = output / \"fresh-clone\"\n   384\t            shutil.copytree(\n   385\t                candidate,\n   386\t                fresh,\n   387\t                ignore=shutil.ignore_patterns(\n   388\t                    \"node_modules\", \"dist\", \"data\", \".DS_Store\"\n   389\t                ),\n   390\t            )\n   391\t            commands.append(\n   392\t                self._command(\n   393\t                    \"npm_ci\",\n   394\t                    [\"npm\", \"ci\"],\n   395\t                    cwd=fresh,\n   396\t                    output=output,\n   397\t                    timeout=600,\n   398\t                )\n   399\t            )\n   400\t            commands.append(\n   401\t                self._command(\n   402\t                    \"npm_verify\",\n   403\t                    [\"npm\", \"run\", \"verify\"],\n   404\t                    cwd=fresh,\n   405\t                    output=output,\n   406\t                    timeout=600,\n   407\t                )\n   408\t            )\n   409\t            database = output / \"application.sqlite3\"\n   410\t            environment = {\n   411\t                **os.environ,\n   412\t                \"DATABASE_PATH\": str(database),\n   413\t                \"NODE_ENV\": \"test\",\n   414\t            }\n   415\t            for identifier, command in (\n   416\t                (\"migration_first\", [\"npm\", \"run\", \"db:migrate\"]),\n   417\t                (\"migration_second\", [\"npm\", \"run\", \"db:migrate\"]),\n   418\t                (\"migration_rollback\", [\"npm\", \"run\", \"db:rollback\"]),\n   419\t                (\"migration_reapply\", [\"npm\", \"run\", \"db:migrate\"]),\n   420\t            ):\n   421\t                commands.append(\n   422\t                    self._command(\n   423\t                        identifier,\n   424\t                        command,\n   425\t                        cwd=fresh,\n   426\t                        output=output,\n   427\t                        timeout=120,\n   428\t                        env=environment,\n   429\t                    )\n   430\t                )\n   431\t            assertions.append(\n   432\t                _assertion(\n   433\t                    \"fresh_clone_commands\",\n   434\t                    \"all install/build/test/migration/rollback commands pass\",\n   435\t                    {\n   436\t                        item.id: {\n   437\t                            \"exit_code\": item.exit_code,\n   438\t                            \"elapsed_seconds\": item.elapsed_seconds,\n   439\t                        }\n   440\t                        for item in commands\n   441\t                    },\n   442\t                    all(item.passed for item in commands),\n   443\t                    \"P0\",\n   444\t                )\n   445\t            )\n   446\t            port = _free_port()\n   447\t            origin = f\"http://127.0.0.1:{port}\"\n   448\t            server_stdout = (output / \"server.stdout.log\").open(\"w\", encoding=\"utf-8\")\n   449\t            server_stderr = (output / \"server.stderr.log\").open(\"w\", encoding=\"utf-8\")\n   450\t            server = subprocess.Popen(\n   451\t                [\"npm\", \"start\"],\n   452\t                cwd=fresh,\n   453\t                stdout=server_stdout,\n   454\t                stderr=server_stderr,\n   455\t                text=True,\n   456\t                env={\n   457\t                    **environment,\n   458\t                    \"PORT\": str(port),\n   459\t                    \"HOST\": \"127.0.0.1\",\n   460\t                },\n   461\t            )\n   462\t            deadline = time.monotonic() + 30\n   463\t            health_status = 0\n   464\t            health_body: dict[str, Any] = {}\n   465\t            while time.monotonic() < deadline:\n   466\t                try:\n   467\t                    health_status, health_body, _elapsed = _http_json(\n   468\t                        \"GET\", f\"{origin}/api/health\", timeout=1\n   469\t                    )\n   470\t                    if health_status == 200:\n   471\t                        break\n   472\t                except OSError:\n   473\t                    time.sleep(0.1)\n   474\t            if health_status != 200:\n   475\t                raise RuntimeError(\"NOCTURNE/ONE application did not become healthy\")\n   476\t            runtime[\"server_process_id\"] = server.pid\n   477\t            runtime[\"origin\"] = origin\n   478\t            runtime[\"host\"] = platform.platform()\n   479\t            runtime[\"health\"] = health_body\n   480\t            api = self._api_evaluation(origin)\n   481\t            assertions.extend(self._api_assertions(api))\n   482\t            hidden_trace = json.loads(\n   483\t                hidden_mobile_trace_path.expanduser()\n   484\t                .resolve()\n   485\t                .read_text(encoding=\"utf-8\")\n   486\t            )\n   487\t            browser, performance, accessibility = self._browser_evaluation(\n   488\t                origin=origin,\n   489\t                output=output,\n   490\t                hidden_trace=hidden_trace,\n   491\t            )\n   492\t            performance[\"hero_glb_bytes\"] = (\n   493\t                candidate\n   494\t                / \"public\"\n   495\t                / \"assets\"\n   496\t                / \"nocturne-one-hero.glb\"\n   497\t            ).stat().st_size\n   498\t            performance[\"mobile_lod_glb_bytes\"] = (\n   499\t                candidate\n   500\t                / \"public\"\n   501\t                / \"assets\"\n   502\t                / \"nocturne-one-low.glb\"\n   503\t            ).stat().st_size\n   504\t            assertions.extend(\n   505\t                self._browser_assertions(browser, performance, accessibility)\n   506\t            )\n   507\t            assertions.append(\n   508\t                _assertion(\n   509\t                    \"release_receipt_verifies\",\n   510\t                    {\n   511\t                        \"valid\": True,\n   512\t                        \"manual_edits_outside_receipt_chain\": False,\n   513\t                        \"oracle_source_access\": False,\n   514\t                    },\n   515\t                    {\n   516\t                        **candidate_verification,\n   517\t                        \"manual_edits_outside_receipt_chain\": (\n   518\t                            build_receipt.manual_edits_outside_receipt_chain\n   519\t                        ),\n   520\t                        \"oracle_source_access\": build_receipt.oracle_source_access,\n   521\t                    },\n   522\t                    candidate_verification[\"valid\"]\n   523\t                    and not build_receipt.manual_edits_outside_receipt_chain\n   524\t                    and not build_receipt.oracle_source_access,\n   525\t                    \"P0\",\n   526\t                )\n   527\t            )\n   528\t            assertions.append(\n   529\t                _assertion(\n   530\t                    \"failed_variants_preserved\",\n   531\t                    \"every declared attempt has a retained digest-bound receipt\",\n   532\t                    [item.model_dump(mode=\"json\") for item in build_receipt.attempts],\n   533\t                    all(\n   534\t                        (candidate / item.retained_path).is_file()\n   535\t                        and sha256_file(candidate / item.retained_path)[0]\n   536\t                        == item.receipt_sha256\n   537\t                        for item in build_receipt.attempts\n   538\t                    ),\n   539\t                )\n   540\t            )\n   541\t            for path in sorted(output.rglob(\"*\")):\n   542\t                if path.is_file() and not path.is_relative_to(fresh / \"node_modules\"):\n   543\t                    output_digests[path.relative_to(output).as_posix()] = (\n   544\t                        sha256_file(path)[0]\n   545\t                    )\n   546\t        except Exception as error:\n   547\t            failure = f\"{type(error).__name__}: {error}\"\n   548\t            atomic_write_json(\n   549\t                output / \"nocturne-app.failure.json\",\n   550\t                {\n   551\t                    \"schema_version\": \"1\",\n   552\t                    \"failure\": failure,\n   553\t                    \"completed_at\": datetime.now(UTC).isoformat(),\n   554\t                },\n   555\t            )\n   556\t        finally:\n   557\t            if server is not None:\n   558\t                server.terminate()\n   559\t                try:\n   560\t                    server.wait(timeout=10)\n   561\t                except subprocess.TimeoutExpired:\n   562\t                    server.kill()\n   563\t                    server.wait(timeout=5)\n   564\t        functional_passed = (\n   565\t            bool(assertions)\n   566\t            and all(item.passed for item in assertions)\n   567\t            and all(item.passed for item in commands)\n   568\t            and failure is None\n   569\t        )\n   570\t        receipt = NocturneAppReceipt(\n   571\t            benchmark_id=self.contract.benchmark_id,\n   572\t            source_git_head=source_head,\n   573\t            contract_sha256=contract_digest,\n   574\t            packet_manifest_sha256=packet_verification[\"packet_manifest_sha256\"],\n   575\t            sealed_builder_receipt_sha256=sha256_file(sealed_receipt_path)[0],\n   576\t            candidate_build_receipt_sha256=candidate_verification[\"receipt_sha256\"],\n   577\t            started_at=started_at,\n   578\t            completed_at=datetime.now(UTC).isoformat(),\n   579\t            elapsed_seconds=time.monotonic() - started,\n   580\t            status=\"PASS\" if functional_passed else \"FAIL\",\n   581\t            functional_passed=functional_passed,\n   582\t            assertions=assertions,\n   583\t            commands=commands,\n   584\t            api=api,\n   585\t            browser=browser,\n   586\t            performance=performance,\n   587\t            accessibility=accessibility,\n   588\t            output_digests=output_digests,\n   589\t            runtime=runtime,\n   590\t            claim_boundary=[\n   591\t                \"The evaluator installs from the lockfile in a fresh copied source tree.\",\n   592\t                \"Browser, API, database, migration, accessibility, fallback, and performance \"\n   593\t                \"gates execute on the real local application path.\",\n   594\t                \"The selected accessibility scanner is deterministic but does not replace \"\n   595\t                \"manual assistive-technology review.\",\n   596\t                \"Performance results are specific to the recorded browser and host.\",\n   597\t            ],\n   598\t            workspace=str(output),\n   599\t            failure=failure,\n   600\t        )\n   601\t        atomic_write_json(\n   602\t            output / \"nocturne-app.receipt.json\",\n   603\t            receipt.model_dump(mode=\"json\"),\n   604\t        )\n   605\t        return receipt\n   606\t\n   607\t    @staticmethod\n   608\t    def _command(\n   609\t        identifier: str,\n   610\t        command: list[str],\n   611\t        *,\n   612\t        cwd: Path,\n   613\t        output: Path,\n   614\t        timeout: int,\n   615\t        env: dict[str, str] | None = None,\n   616\t    ) -> CommandReceipt:\n   617\t        started = time.monotonic()\n   618\t        completed = subprocess.run(\n   619\t            command,\n   620\t            cwd=cwd,\n   621\t            capture_output=True,\n   622\t            text=True,\n   623\t            timeout=timeout,\n   624\t            env=env,\n   625\t            check=False,\n   626\t        )\n   627\t        stdout = output / f\"{identifier}.stdout.log\"\n   628\t        stderr = output / f\"{identifier}.stderr.log\"\n   629\t        stdout.write_text(completed.stdout, encoding=\"utf-8\")\n   630\t        stderr.write_text(completed.stderr, encoding=\"utf-8\")\n   631\t        return CommandReceipt(\n   632\t            id=identifier,\n   633\t            command=command,\n   634\t            exit_code=completed.returncode,\n   635\t            elapsed_seconds=time.monotonic() - started,\n   636\t            stdout_sha256=sha256_file(stdout)[0],\n   637\t            stderr_sha256=sha256_file(stderr)[0],\n   638\t            passed=completed.returncode == 0,\n   639\t        )\n   640\t\n   641\t    def _api_evaluation(self, origin: str) -> dict[str, Any]:\n   642\t        configuration = {\n   643\t            \"variant\": \"ember\",\n   644\t            \"light_intensity\": 72,\n   645\t            \"orientation\": 18,\n   646\t            \"accessory\": \"braided-cable\",\n   647\t        }\n   648\t        valid = {\n   649\t            \"configuration\": configuration,\n   650\t            \"email\": \"builder@example.invalid\",\n   651\t        }\n   652\t        auth = {\n   653\t            \"X-NOCTURNE-ACTOR\": \"benchmark-actor\",\n   654\t            \"X-NOCTURNE-PERMISSIONS\": \"reservation:create\",\n   655\t            \"Idempotency-Key\": \"nocturne-fixed-idempotency-key\",\n   656\t        }\n   657\t        unauthorized = _http_json(\n   658\t            \"POST\", f\"{origin}/api/reservations\", payload=valid\n   659\t        )\n   660\t        missing_permission = _http_json(\n   661\t            \"POST\",\n   662\t            f\"{origin}/api/reservations\",\n   663\t            payload=valid,\n   664\t            headers={\"X-NOCTURNE-ACTOR\": \"benchmark-actor\"},\n   665\t        )\n   666\t        invalid = _http_json(\n   667\t            \"POST\",\n   668\t            f\"{origin}/api/reservations\",\n   669\t            payload={**valid, \"email\": \"invalid\"},\n   670\t            headers=auth,\n   671\t        )\n   672\t        transient = _http_json(\n   673\t            \"POST\",\n   674\t            f\"{origin}/api/reservations\",\n   675\t            payload=valid,\n   676\t            headers={**auth, \"X-NOCTURNE-SIMULATE\": \"transient\"},\n   677\t        )\n   678\t        first = _http_json(\n   679\t            \"POST\",\n   680\t            f\"{origin}/api/reservations\",\n   681\t            payload=valid,\n   682\t            headers=auth,\n   683\t        )\n   684\t        repeated = _http_json(\n   685\t            \"POST\",\n   686\t            f\"{origin}/api/reservations\",\n   687\t            payload=valid,\n   688\t            headers=auth,\n   689\t        )\n   690\t        conflict = _http_json(\n   691\t            \"POST\",\n   692\t            f\"{origin}/api/reservations\",\n   693\t            payload={**valid, \"email\": \"different@example.invalid\"},\n   694\t            headers=auth,\n   695\t        )\n   696\t        reservation_id = str(first[1].get(\"id\", \"\"))\n   697\t        own_lookup = _http_json(\n   698\t            \"GET\",\n   699\t            f\"{origin}/api/reservations/{reservation_id}\",\n   700\t            headers={\"X-NOCTURNE-ACTOR\": \"benchmark-actor\"},\n   701\t        )\n   702\t        cross_actor = _http_json(\n   703\t            \"GET\",\n   704\t            f\"{origin}/api/reservations/{reservation_id}\",\n   705\t            headers={\"X-NOCTURNE-ACTOR\": \"other-actor\"},\n   706\t        )\n   707\t        samples = [\n   708\t            _http_json(\"GET\", f\"{origin}/api/health\")[2]\n   709\t            for _index in range(\n   710\t                int(self.contract.performance_budget[\"api_sample_count\"])\n   711\t            )\n   712\t        ]\n   713\t        return {\n   714\t            \"unauthorized\": {\"status\": unauthorized[0], \"body\": unauthorized[1]},\n   715\t            \"missing_permission\": {\n   716\t                \"status\": missing_permission[0],\n   717\t                \"body\": missing_permission[1],\n   718\t            },\n   719\t            \"invalid\": {\"status\": invalid[0], \"body\": invalid[1]},\n   720\t            \"transient\": {\"status\": transient[0], \"body\": transient[1]},\n   721\t            \"first\": {\"status\": first[0], \"body\": first[1]},\n   722\t            \"repeated\": {\"status\": repeated[0], \"body\": repeated[1]},\n   723\t            \"conflict\": {\"status\": conflict[0], \"body\": conflict[1]},\n   724\t            \"own_lookup\": {\"status\": own_lookup[0], \"body\": own_lookup[1]},\n   725\t            \"cross_actor\": {\"status\": cross_actor[0], \"body\": cross_actor[1]},\n   726\t            \"latency_samples_ms\": samples,\n   727\t            \"p95_ms\": _percentile(samples, 0.95),\n   728\t        }\n   729\t\n   730\t    def _api_assertions(self, api: dict[str, Any]) -> list[AppAssertion]:\n   731\t        first_id = api[\"first\"][\"body\"].get(\"id\")\n   732\t        repeated_id = api[\"repeated\"][\"body\"].get(\"id\")\n   733\t        return [\n   734\t            _assertion(\n   735\t                \"api_auth_policy\",\n   736\t                {\"unauthenticated\": 401, \"missing_permission\": 403},\n   737\t                {\n   738\t                    \"unauthenticated\": api[\"unauthorized\"][\"status\"],\n   739\t                    \"missing_permission\": api[\"missing_permission\"][\"status\"],\n   740\t                },\n   741\t                api[\"unauthorized\"][\"status\"] == 401\n   742\t                and api[\"missing_permission\"][\"status\"] == 403,\n   743\t                \"P0\",\n   744\t            ),\n   745\t            _assertion(\n   746\t                \"api_validation_and_transient_errors\",\n   747\t                {\"validation\": 400, \"transient\": 503},\n   748\t                {\n   749\t                    \"validation\": api[\"invalid\"][\"status\"],\n   750\t                    \"transient\": api[\"transient\"][\"status\"],\n   751\t                },\n   752\t                api[\"invalid\"][\"status\"] == 400\n   753\t                and api[\"transient\"][\"status\"] == 503,\n   754\t                \"P0\",\n   755\t            ),\n   756\t            _assertion(\n   757\t                \"reservation_idempotency\",\n   758\