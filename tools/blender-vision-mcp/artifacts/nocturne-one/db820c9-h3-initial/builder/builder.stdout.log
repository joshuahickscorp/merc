18\t            observed_states.update(\n  1119\t                scenario_page.evaluate(\"() => __NOCTURNE__.stateHistory\")\n  1120\t            )\n  1121\t            scenario_context.close()\n  1122\t            memory_samples: list[int] = []\n  1123\t            memory_started = time.monotonic()\n  1124\t            memory_duration = int(\n  1125\t                self.contract.performance_budget[\"interaction_loop_seconds\"]\n  1126\t            )\n  1127\t            interval = int(\n  1128\t                self.contract.performance_budget[\n  1129\t                    \"interaction_loop_sample_interval_seconds\"\n  1130\t                ]\n  1131\t            )\n  1132\t            page.goto(f\"{origin}/\", wait_until=\"networkidle\")\n  1133\t            page.locator(\"#enter-3d\").click()\n  1134\t            page.wait_for_function(\"() => __NOCTURNE__.state === '3d_ready'\")\n  1135\t            while time.monotonic() - memory_started < memory_duration:\n  1136\t                page.evaluate(\n  1137\t                    \"\"\"() => {\n  1138\t                      const next = (__NOCTURNE__.config.orientation + 1) % 45;\n  1139\t                      __NOCTURNE__.setConfiguration({orientation: next});\n  1140\t                      globalThis.gc?.();\n  1141\t                    }\"\"\"\n  1142\t                )\n  1143\t                memory_samples.append(\n  1144\t                    int(\n  1145\t                        page.evaluate(\n  1146\t                            \"() => performance.memory?.usedJSHeapSize || 0\"\n  1147\t                        )\n  1148\t                    )\n  1149\t                )\n  1150\t                page.wait_for_timeout(interval * 1000)\n  1151\t            browser_version = browser.version\n  1152\t            browser.close()\n  1153\t        html_css_transfer = sum(\n  1154\t            int(item[\"transferSize\"] or item[\"encodedBodySize\"] or 0)\n  1155\t            for item in resources\n  1156\t            if item[\"initiatorType\"] in {\"css\"} or item[\"name\"] in {\"/\", \"/index.html\"}\n  1157\t        )\n  1158\t        javascript_transfer = sum(\n  1159\t            int(item[\"transferSize\"] or item[\"encodedBodySize\"] or 0)\n  1160\t            for item in resources\n  1161\t            if item[\"initiatorType\"] == \"script\"\n  1162\t        )\n  1163\t        glb_paths = [\n  1164\t            item[\"name\"] for item in resources if item[\"name\"].endswith(\".glb\")\n  1165\t        ]\n  1166\t        memory_growth = (\n  1167\t            max(0, memory_samples[-1] - memory_samples[0])\n  1168\t            if len(memory_samples) >= 2\n  1169\t            else 0\n  1170\t        )\n  1171\t        browser_record = {\n  1172\t            \"engine\": \"chromium\",\n  1173\t            \"version\": browser_version,\n  1174\t            \"routes\": route_records,\n  1175\t            \"declared_states\": declared_states,\n  1176\t            \"observed_states\": sorted(observed_states),\n  1177\t            \"observed_control_ids\": sorted(all_control_ids),\n  1178\t            \"poster_before_3d\": poster_before,\n  1179\t            \"ready_state\": ready,\n  1180\t            \"configuration\": configured,\n  1181\t            \"restored_configuration\": restored,\n  1182\t            \"selected_part\": selected_part,\n  1183\t            \"keyboard_targets\": keyboard_targets,\n  1184\t            \"reduced_motion\": reduced,\n  1185\t            \"fallback_routes\": fallback_routes,\n  1186\t            \"fallback_state\": fallback_state,\n  1187\t            \"hidden_mobile_trace\": hidden_trace_result,\n  1188\t            \"mobile_horizontal_overflow\": mobile_overflow,\n  1189\t            \"initial_request_paths\": initial_paths,\n  1190\t            \"glb_resource_paths\": glb_paths,\n  1191\t        }\n  1192\t        performance_record = {\n  1193\t            \"critical_html_css_transfer_bytes\": html_css_transfer,\n  1194\t            \"initial_javascript_transfer_bytes\": javascript_transfer,\n  1195\t            \"cumulative_layout_shift\": cls,\n  1196\t            \"desktop_frame_sample_count\": len(frame_durations),\n  1197\t            \"desktop_median_fps\": desktop_median_fps,\n  1198\t            \"desktop_frame_p95_ms\": desktop_p95,\n  1199\t            \"mobile_frame_sample_count\": len(mobile_frames),\n  1200\t            \"mobile_median_fps\": mobile_median_fps,\n  1201\t            \"mobile_frame_p95_ms\": mobile_p95,\n  1202\t            \"memory_duration_seconds\": memory_duration,\n  1203\t            \"memory_samples_bytes\": memory_samples,\n  1204\t            \"memory_growth_bytes\": memory_growth,\n  1205\t            \"resource_entries\": resources,\n  1206\t        }\n  1207\t        critical = sum(\n  1208\t            finding[\"severity\"] == \"critical\"\n  1209\t            for findings in accessibility_records.values()\n  1210\t            for finding in findings\n  1211\t        )\n  1212\t        serious = sum(\n  1213\t            finding[\"severity\"] == \"serious\"\n  1214\t            for findings in accessibility_records.values()\n  1215\t            for finding in findings\n  1216\t        )\n  1217\t        accessibility_record = {\n  1218\t            \"scanner\": \"NocturneAccessibilityScanner/v1\",\n  1219\t            \"routes\": accessibility_records,\n  1220\t            \"critical_violation_count\": critical,\n  1221\t            \"serious_violation_count\": serious,\n  1222\t        }\n  1223\t        return browser_record, performance_record, accessibility_record\n  1224\t\n  1225\t    @staticmethod\n  1226\t    def _accessibility_scan(page: Any) -> list[dict[str, str]]:\n  1227\t        return page.evaluate(\n  1228\t            \"\"\"() => {\n  1229\t              const findings = [];\n  1230\t              const add = (id, severity, message) =>\n  1231\t                findings.push({id, severity, message});\n  1232\t              if (!document.documentElement.lang) {\n  1233\t                add(\"html-lang\", \"serious\", \"Document language is missing.\");\n  1234\t              }\n  1235\t              if (document.querySelectorAll(\"main\").length !== 1) {\n  1236\t                add(\"main-landmark\", \"critical\", \"Route requires exactly one main.\");\n  1237\t              }\n  1238\t              if (document.querySelectorAll(\"h1\").length !== 1) {\n  1239\t                add(\"h1\", \"serious\", \"Route requires exactly one level-one heading.\");\n  1240\t              }\n  1241\t              for (const element of document.querySelectorAll(\n  1242\t                \"button,a[href],input,select,textarea\"\n  1243\t              )) {\n  1244\t                const name = (\n  1245\t                  element.getAttribute(\"aria-label\")\n  1246\t                  || element.getAttribute(\"title\")\n  1247\t                  || element.textContent\n  1248\t                  || element.id && document.querySelector(`label[for=\"${element.id}\"]`)?.textContent\n  1249\t                  || \"\"\n  1250\t                ).trim();\n  1251\t                if (!name) {\n  1252\t                  add(\"accessible-name\", \"critical\", `${element.tagName} has no name.`);\n  1253\t                }\n  1254\t              }\n  1255\t              for (const image of document.querySelectorAll(\"img\")) {\n  1256\t                if (!image.hasAttribute(\"alt\")) {\n  1257\t                  add(\"image-alt\", \"serious\", \"Image is missing alt.\");\n  1258\t                }\n  1259\t              }\n  1260\t              if (!document.querySelector('a[href=\"#main\"]')) {\n46:    silhouette_iou: float = Field(ge=0, le=1)\n106:def _silhouette_iou(reference: Path, candidate: Path) -> float:\n111:            f\"silhouette dimensions differ: {first.shape} != {second.shape}\"\n119:def _material_class_checks(details: dict[str, Any]) -> dict[str, bool]:\n286:                    nocturne_benchmark_root() / \"governed_spec.json\"\n295:            observed_vector = inspection[\"primary_dimensions_mm\"]\n513:                self.contract.geometry_gates[\"public_silhouette_iou_minimum\"]\n516:                self.contract.geometry_gates[\"hidden_silhouette_iou_minimum\"]\n521:                    output / \"silhouettes\" / f\"{label}.candidate.png\"\n523:                score = _silhouette_iou(oracle_path, candidate_path)\n530:                        silhouette_iou=score,\n538:                    output / \"silhouettes\" / f\"{label}.candidate.png\"\n540:                score = _silhouette_iou(oracle_path, candidate_path)\n547:                        silhouette_iou=score,\n553:                item.silhouette_iou\n558:                item.silhouette_iou\n564:                    \"public_silhouettes\",\n574:                    \"hidden_silhouettes\",\n653:                \"Public and hidden silhouettes use fixed oracle camera states with no nudge.\",\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport json\n     4\timport math\n     5\timport platform\n     6\timport subprocess\n     7\timport time\n     8\tfrom datetime import UTC, datetime\n     9\tfrom pathlib import Path\n    10\tfrom typing import Any, Literal\n    11\t\n    12\timport numpy as np\n    13\tfrom PIL import Image\n    14\tfrom pydantic import BaseModel, ConfigDict, Field\n    15\t\n    16\tfrom blender_vision.benchmarks.nocturne import (\n    17\t    NocturnePacketAuthority,\n    18\t    SealedBuilderReceipt,\n    19\t    load_nocturne_contract,\n    20\t    nocturne_benchmark_root,\n    21\t)\n    22\tfrom blender_vision.core.config import discover_blender\n    23\tfrom blender_vision.core.errors import SecurityError\n    24\tfrom blender_vision.core.util import atomic_write_json, code_revision, sha256_file\n    25\tfrom blender_vision.geometry.gltf_validator import GlbValidator\n    26\tfrom blender_vision.security.adversarial import SealedBenchmarkBoundary\n    27\t\n    28\t\n    29\tclass _StrictModel(BaseModel):\n    30\t    model_config = ConfigDict(extra=\"forbid\")\n    31\t\n    32\t\n    33\tclass Nocturne3DAssertion(_StrictModel):\n    34\t    id: str\n    35\t    expected: Any\n    36\t    observed: Any\n    37\t    passed: bool\n    38\t    severity: Literal[\"P0\", \"P1\", \"P2\"]\n    39\t\n    40\t\n    41\tclass NocturneViewScore(_StrictModel):\n    42\t    label: str\n    43\t    visibility: Literal[\"public\", \"hidden\"]\n    44\t    oracle_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    45\t    candidate_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    46\t    silhouette_iou: float = Field(ge=0, le=1)\n    47\t    threshold: float = Field(ge=0, le=1)\n    48\t    passed: bool\n    49\t\n    50\t\n    51\tclass Nocturne3DReceipt(_StrictModel):\n    52\t    schema_version: Literal[\"1\"] = \"1\"\n    53\t    benchmark_id: Literal[\"nocturne-one-sealed-v1\"]\n    54\t    source_git_head: str = Field(pattern=r\"^[0-9a-f]{40}$\")\n    55\t    contract_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    56\t    packet_manifest_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    57\t    sealed_builder_receipt_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    58\t    oracle_manifest_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    59\t    candidate_blend_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    60\t    candidate_hero_glb_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    61\t    candidate_low_glb_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n    62\t    started_at: str\n    63\t    completed_at: str\n    64\t    elapsed_seconds: float = Field(ge=0)\n    65\t    status: Literal[\"PASS\", \"FAIL\"]\n    66\t    functional_passed: bool\n    67\t    assertions: list[Nocturne3DAssertion]\n    68\t    view_scores: list[NocturneViewScore]\n    69\t    inspection: dict[str, Any] | None\n    70\t    hero_glb_validation: dict[str, Any] | None\n    71\t    low_glb_validation: dict[str, Any] | None\n    72\t    leakage_boundary: dict[str, Any] | None\n    73\t    output_digests: dict[str, str]\n    74\t    runtime: dict[str, Any]\n    75\t    claim_boundary: list[str]\n    76\t    workspace: str\n    77\t    failure: str | None = None\n    78\t\n    79\t\n    80\tclass Nocturne3DEvaluationError(ValueError):\n    81\t    pass\n    82\t\n    83\t\n    84\tdef _assertion(\n    85\t    identifier: str,\n    86\t    expected: Any,\n    87\t    observed: Any,\n    88\t    passed: bool,\n    89\t    severity: Literal[\"P0\", \"P1\", \"P2\"] = \"P1\",\n    90\t) -> Nocturne3DAssertion:\n    91\t    return Nocturne3DAssertion(\n    92\t        id=identifier,\n    93\t        expected=expected,\n    94\t        observed=observed,\n    95\t        passed=passed,\n    96\t        severity=severity,\n    97\t    )\n    98\t\n    99\t\n   100\tdef _alpha_mask(path: Path) -> np.ndarray:\n   101\t    image = Image.open(path).convert(\"RGBA\")\n   102\t    alpha = np.asarray(image, dtype=np.uint8)[:, :, 3]\n   103\t    return alpha >= 12\n   104\t\n   105\t\n   106\tdef _silhouette_iou(reference: Path, candidate: Path) -> float:\n   107\t    first = _alpha_mask(reference)\n   108\t    second = _alpha_mask(candidate)\n   109\t    if first.shape != second.shape:\n   110\t        raise ValueError(\n   111\t            f\"silhouette dimensions differ: {first.shape} != {second.shape}\"\n   112\t        )\n   113\t    union = np.logical_or(first, second)\n   114\t    if not bool(union.any()):\n   115\t        return 1.0\n   116\t    return float(np.logical_and(first, second).sum() / union.sum())\n   117\t\n   118\t\n   119\tdef _material_class_checks(details: dict[str, Any]) -> dict[str, bool]:\n   120\t    def item(name: str) -> dict[str, Any]:\n   121\t        return details.get(name, {})\n   122\t\n   123\t    shell = item(\"MAT_BLACK_ANODIZED_ALUMINUM\")\n   124\t    glass = item(\"MAT_FROSTED_TRANSLUCENT_GLASS\")\n   125\t    emissive = item(\"MAT_WARM_EMISSIVE_CERAMIC\")\n   126\t    membrane = item(\"MAT_GRAPHITE_TENSIONED_TEXTILE\")\n   127\t    control = item(\"MAT_MACHINED_ALUMINUM\")\n   128\t    return {\n   129\t        \"black_anodized_is_metallic\": float(shell.get(\"Metallic\", 0)) >= 0.65,\n   130\t        \"black_anodized_is_not_mirror\": 0.12\n   131\t        <= float(shell.get(\"Roughness\", 1))\n   132\t        <= 0.48,\n   133\t        \"glass_is_transmissive\": float(glass.get(\"Transmission Weight\", 0)) >= 0.45,\n   134\t        \"glass_is_frosted\": float(glass.get(\"Roughness\", 0)) >= 0.16,\n   135\t        \"eclipse_is_emissive\": float(emissive.get(\"Emission Strength\", 0)) >= 2.0,\n   136\t        \"membrane_is_high_roughness\": float(membrane.get(\"Roughness\", 0)) >= 0.7,\n   137\t        \"rotary_control_is_metallic\": float(control.get(\"Metallic\", 0)) >= 0.7,\n   138\t        \"glass_and_emissive_are_separate\": bool(glass) and bool(emissive),\n   139\t    }\n   140\t\n   141\t\n   142\tclass Nocturne3DEvaluator:\n   143\t    def __init__(self, contract_path: Path | None = None):\n   144\t        self.contract, self.contract_path = load_nocturne_contract(contract_path)\n   145\t\n   146\t    def run(\n   147\t        self,\n   148\t        *,\n   149\t        packet_root: Path,\n   150\t        sealed_oracle_root: Path,\n   151\t        candidate_root: Path,\n   152\t        sealed_builder_receipt_path: Path,\n   153\t        output_root: Path,\n   154\t    ) -> Nocturne3DReceipt:\n   155\t        packet = packet_root.expanduser().resolve()\n   156\t        sealed = sealed_oracle_root.expanduser().resolve()\n   157\t        candidate = candidate_root.expanduser().resolve()\n   158\t        output = output_root.expanduser().resolve()\n   159\t        if output.exists() and any(output.iterdir()):\n   160\t            raise Nocturne3DEvaluationError(\"3D evaluator output must be new or empty\")\n   161\t        output.mkdir(parents=True, exist_ok=True)\n   162\t        packet_receipt = NocturnePacketAuthority(self.contract_path).verify(packet)\n   163\t        builder_receipt_path = sealed_builder_receipt_path.expanduser().resolve()\n   164\t        builder_receipt = SealedBuilderReceipt.model_validate_json(\n   165\t            builder_receipt_path.read_text(encoding=\"utf-8\")\n   166\t        )\n   167\t        if builder_receipt.status != \"PASS\":\n   168\t            raise SecurityError(\"3D evaluation requires a passing sealed builder receipt\")\n   169\t        contract_digest = sha256_file(self.contract_path)[0]\n   170\t        if builder_receipt.contract_sha256 != contract_digest:\n   171\t            raise SecurityError(\"sealed builder receipt is bound to another contract\")\n   172\t        oracle_manifest_path = sealed / \"oracle.manifest.json\"\n   173\t        oracle_manifest = json.loads(\n   174\t            oracle_manifest_path.read_text(encoding=\"utf-8\")\n   175\t        )\n   176\t        canary = (sealed / \"ORACLE_CANARY.txt\").read_text(encoding=\"utf-8\")\n   177\t        blend = candidate / \"3d\" / \"nocturne-one.blend\"\n   178\t        hero_glb = candidate / \"public\" / \"assets\" / \"nocturne-one-hero.glb\"\n   179\t        low_glb = candidate / \"public\" / \"assets\" / \"nocturne-one-low.glb\"\n   180\t        for path in (blend, hero_glb, low_glb):\n   181\t            if path.is_symlink() or not path.is_file():\n   182\t                raise Nocturne3DEvaluationError(\n   183\t                    f\"required candidate 3D artifact is missing or linked: {path}\"\n   184\t                )\n   185\t        source_head = code_revision(Path(__file__).resolve().parents[3])\n   186\t        if len(source_head) != 40:\n   187\t            raise Nocturne3DEvaluationError(\n   188\t                \"3D evaluation requires a full Git source revision\"\n   189\t            )\n   190\t        started_at = datetime.now(UTC).isoformat()\n   191\t        started = time.monotonic()\n   192\t        assertions: list[Nocturne3DAssertion] = []\n   193\t        view_scores: list[NocturneViewScore] = []\n   194\t        inspection: dict[str, Any] | None = None\n   195\t        hero_validation: dict[str, Any] | None = None\n   196\t        low_validation: dict[str, Any] | None = None\n   197\t        leakage: dict[str, Any] | None = None\n   198\t        output_digests: dict[str, str] = {}\n   199\t        runtime: dict[str, Any] = {}\n   200\t        failure: str | None = None\n   201\t        try:\n   202\t            leakage = SealedBenchmarkBoundary.verify(\n   203\t                candidate,\n   204\t                sealed,\n   205\t                canaries=[canary],\n   206\t                maximum_scan_bytes=512 * 1024 * 1024,\n   207\t            )\n   208\t            oracle_blend = sealed / \"nocturne-one-oracle.blend\"\n   209\t            candidate_blend_digest = sha256_file(blend)[0]\n   210\t            oracle_blend_digest = sha256_file(oracle_blend)[0]\n   211\t            assertions.append(\n   212\t                _assertion(\n   213\t                    \"candidate_is_not_oracle_blend\",\n   214\t                    \"different SHA-256\",\n   215\t                    {\n   216\t                        \"candidate\": candidate_blend_digest,\n   217\t                        \"oracle\": oracle_blend_digest,\n   218\t                    },\n   219\t                    candidate_blend_digest != oracle_blend_digest,\n   220\t                    \"P0\",\n   221\t                )\n   222\t            )\n   223\t            blender = discover_blender()\n   224\t            if not blender.available or not blender.path:\n   225\t                raise RuntimeError(\"installed Blender is unavailable\")\n   226\t            inspect_script = (\n   227\t                nocturne_benchmark_root()\n   228\t                / \"evaluator\"\n   229\t                / \"inspect_candidate.py\"\n   230\t            )\n   231\t            command = [\n   232\t                blender.path,\n   233\t                \"--background\",\n   234\t 