\n   908\t                \"() => ({poster: __NOCTURNE__.posterVisible, glb: __NOCTURNE__.glbRequested})\"\n   909\t            )\n   910\t            initial_paths = list(response_paths)\n   911\t            page.locator(\"#enter-3d\").click()\n   912\t            page.wait_for_function(\n   913\t                \"() => ['3d_ready','3d_unavailable'].includes(__NOCTURNE__.state)\"\n   914\t            )\n   915\t            ready = page.evaluate(\n   916\t                \"\"\"() => ({\n   917\t                  state: __NOCTURNE__.state,\n   918\t                  stateHistory: __NOCTURNE__.stateHistory,\n   919\t                  glbRequested: __NOCTURNE__.glbRequested,\n   920\t                  webglAvailable: __NOCTURNE__.webglAvailable,\n   921\t                  posterVisible: __NOCTURNE__.posterVisible,\n   922\t                })\"\"\"\n   923\t            )\n   924\t            observed_states.update(ready[\"stateHistory\"])\n   925\t            frame_durations = [\n   926\t                float(value)\n   927\t                for value in page.evaluate(\n   928\t                    \"(count) => __NOCTURNE__.sampleFrames(count)\",\n   929\t                    int(self.contract.performance_budget[\"frame_sample_count\"]),\n   930\t                )\n   931\t            ]\n   932\t            desktop_median_fps = 1000 / statistics.median(frame_durations)\n   933\t            desktop_p95 = _percentile(frame_durations, 0.95)\n   934\t            resources = page.evaluate(\n   935\t                \"\"\"() => performance.getEntriesByType(\"resource\").map(entry => ({\n   936\t                  name: new URL(entry.name).pathname,\n   937\t                  initiatorType: entry.initiatorType,\n   938\t                  transferSize: entry.transferSize,\n   939\t                  encodedBodySize: entry.encodedBodySize,\n   940\t                }))\"\"\"\n   941\t            )\n   942\t            cls = float(\n   943\t                page.evaluate(\"() => globalTh