\n    \"accessibility_covers_every_route\",\n    \"manual_edits_require_receipt_chain\",\n    \"failed_variants_are_preserved\",\n    \"unsuccessful_runs_remain_in_score_report\"\n  ],\n  \"claim_boundary\": [\n    \"Thresholds are specific to NOCTURNE/ONE and the recorded test environment.\",\n    \"Passing does not establish universal application or 3D reconstruction quality.\",\n    \"Public parametric dimensions are authoritative textual evidence, not hidden mesh data.\",\n    \"Hidden cameras and mobile traces remain evaluator-only during builder execution.\"\n  ]\n}\n/private/tmp/nocturne-one-public-packet-db820c9/accessibility-requirements.json\n/private/tmp/nocturne-one-public-packet-db820c9/api-contract.json\n/private/tmp/nocturne-one-public-packet-db820c9/authorization-policy.json\n/private/tmp/nocturne-one-public-packet-db820c9/data-schema.json\n/private/tmp/nocturne-one-public-packet-db820c9/dimension-sheet.json\n/private/tmp/nocturne-one-public-packet-db820c9/interaction-storyboard.json\n/private/tmp/nocturne-one-public-packet-db820c9/motion/exploded-8s.mp4\n/private/tmp/nocturne-one-public-packet-db820c9/motion/turntable-12s.mp4\n/private/tmp/nocturne-one-public-packet-db820c9/packet.manifest.json\n/private/tmp/nocturne-one-public-packet-db820c9/part-material-specification.json\n/private/tmp/nocturne-one-public-packet-db820c9/performance-budget.json\n/private/tmp/nocturne-one-public-packet-db820c9/product-application-brief.json\n/private/tmp/nocturne-one-public-packet-db820c9/references/front.png\n/private/tmp/nocturne-one-public-packet-db820c9/references/hero.png\n/private/tmp/nocturne-one-public-packet-db820c9/references/left.png\n/private/tmp/nocturne-one-public-packet-db820c9/references/rear.png\n/private/tmp/nocturne-one-public-packet-db820c9/references/right.png\n/private/tmp/nocturne-one-public-packet-db820c9/references/top.png\n/private/tmp/nocturne-one-public-packet-db820c9/visual-mood-board.png\ntools/blender-vision-mcp/benchmarks/nocturne_one/README.md\ntools/blender-vision-mcp/benchmarks/nocturne_one/builder_prompt.md\ntools/blender-vision-mcp/benchmarks/nocturne_one/contract.json\ntools/blender-vision-mcp/benchmarks/nocturne_one/evaluator/inspect_candidate.py\ntools/blender-vision-mcp/benchmarks/nocturne_one/governed_spec.json\n[build-system]\nrequires = [\"hatchling>=1.25\"]\nbuild-backend = \"hatchling.build\"\n\n[project]\nname = \"blender-vision-mcp\"\nversion = \"0.1.0\"\ndescription = \"Evidence-bound reference-to-3D reconstruction workflows for Blender and MCP\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { file = \"LICENSE\" }\nauthors = [{ name = \"ComputExchange\" }]\ndependencies = [\n  \"mcp>=1.12,<2\",\n  \"numpy>=1.26\",\n  \"opencv-python-headless>=4.10\",\n  \"Pillow>=10.4\",\n  \"platformdirs>=4.2\",\n  \"playwright>=1.54,<2\",\n  \"pydantic>=2.8,<3\",\n]\nclassifiers = [\n  \"Development Status :: 3 - Alpha\",\n  \"License :: OSI Approved :: Apache Software License\",\n  \"Programming Language :: Python :: 3\",\n  \"Programming Language :: Python :: 3.11\",\n  \"Programming Language :: Python :: 3.12\",\n  \"Programming Language :: Python :: 3.13\",\n  \"Topic :: Multimedia :: Graphics :: 3D Modeling\",\n]\n\n[project.optional-dependencies]\nvision = [\"numpy>=1.26\", \"opencv-python-headless>=4.10\"]\ndev = [\"jsonschema>=4.23\", \"pytest>=8.2\", \"pytest-asyncio>=0.23\", \"ruff>=0.6\"]\n\n[project.scripts]\nbvmcp = \"blender_vision.cli.main:main\"\nblender-vision = \"blender_vision.mcp.server:main\"\n\n[project.urls]\nRepository = \"https://github.com/joshuahickscorp/blender-vision-mcp\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/blender_vision\"]\n\n[tool.hatch.build.targets.sdist]\nexclude = [\n  \"/artifacts\",\n]\n\n[tool.hatch.build.targets.wheel.force-include]\n\"blender_worker/entry.py\" = \"blender_vision/blender/standalone_worker.py\"\n\"benchmarks/mac_studio/benchmark.json\" = \"blender_vision/benchmarks/data/mac_studio.json\"\n\"benchmar