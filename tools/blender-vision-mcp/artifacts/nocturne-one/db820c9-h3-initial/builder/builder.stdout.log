es.update(\n   978\t                page.evaluate(\"() => __NOCTURNE__.stateHistory\")\n   979\t            )\n   980\t            reduced_context = browser.new_context(\n   981\t                viewport={\"width\": 1280, \"height\": 800},\n   982\t                reduced_motion=\"reduce\",\n   983\t                color_scheme=\"dark\",\n   984\t            )\n   985\t            reduced_page = reduced_context.new_page()\n   986\t            reduced_page.goto(f\"{origin}/\", wait_until=\"networkidle\")\n   987\t            reduced_page.wait_for_function(\"() => Boolean(__NOCTURNE__)\")\n   988\t            reduced = reduced_page.evaluate(\n   989\t                \"\"\"() => ({\n   990\t                  reduced: __NOCTURNE__.reducedMotion,\n   991\t                  animation: __NOCTURNE__.animationEnabled,\n   992\t                  stateHistory: __NOCTURNE__.stateHistory,\n   993\t                })\"\"\"\n   994\t            )\n   995\t            observed_states.update(reduced[\"stateHistory\"])\n   996\t            reduced_context.close()\n   997\t            fallback_context = browser.new_context(\n   998\t                viewport={\"width\": 1280, \"height\": 800},\n   999\t                color_scheme=\"dark\",\n  1000\t            )\n  1001\t            fallback_context.add_init_script(\n  1002\t                \"\"\"(() => {\n  1003\t                  const original = HTMLCanvasElement.prototype.getContext;\n  1004\t                  HTMLCanvasElement.prototype.getContext = function(type, ...args) {\n  1005\t                    if (String(type).startsWith(\"webgl\")) return null;\n  1006\t                    return original.call(this, type, ...args);\n  1007\t                  };\n  1008\t                })();\"\"\"\n  1009\t            )\n  1010\t            fallback_page = fallback_context.new_page()\n  1011\t            fallback_routes: dict[str, Any] = {}\n  1012\t            for route in self.contract.application_routes:\n  1013\t                fal