{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/state-graph.schema.json",
  "title": "VisionMCP StateGraph",
  "type": "object",
  "required": ["schema", "graph_type", "authority", "target", "nodes", "edges"],
  "properties": {
    "schema": { "const": "vision.state-graph/v1" },
    "graph_type": { "const": "StateGraph" },
    "authority": { "const": "OBSERVED" },
    "target": { "type": "object" },
    "action_inventory_role": { "const": "actionable.inventory" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceNode" }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type", "input", "authority"],
        "properties": { "type": { "const": "TRANSITIONS_TO" } }
      }
    }
  },
  "$defs": {
    "evidenceNode": {
      "type": "object",
      "required": [
        "id",
        "domain_type",
        "spatial_bounds",
        "temporal_validity",
        "evidence_references",
        "authority",
        "confidence",
        "source_restrictions",
        "uncertainty",
        "revision_lineage"
      ]
    }
  }
}
