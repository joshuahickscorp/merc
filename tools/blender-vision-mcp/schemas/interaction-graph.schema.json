{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/interaction-graph.schema.json",
  "title": "VisionMCP InteractionGraph",
  "type": "object",
  "required": ["schema", "graph_type", "authority", "target", "nodes", "edges"],
  "properties": {
    "schema": { "const": "vision.interaction-graph/v1" },
    "graph_type": { "const": "InteractionGraph" },
    "authority": { "const": "OBSERVED" },
    "target": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain_type",
          "spatial_bounds",
          "temporal_validity",
          "evidence_references",
          "authority",
          "confidence",
          "source_restrictions",
          "uncertainty",
          "revision_lineage"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "input", "event_target", "status", "authority"],
        "properties": { "type": { "const": "TRIGGERS" } }
      }
    }
  }
}
