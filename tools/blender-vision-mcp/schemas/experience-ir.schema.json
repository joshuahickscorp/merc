{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/experience-ir.schema.json",
  "title": "VisionMCP ExperienceIR",
  "type": "object",
  "required": [
    "schema",
    "id",
    "authority",
    "capture_ids",
    "targets",
    "source_governance",
    "graph_citations",
    "layout_constraints",
    "states",
    "responsive_rules",
    "interactions",
    "motion",
    "graphics",
    "design_system",
    "accessibility",
    "uncertainty",
    "limitations",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.experience-ir/v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "DERIVED" },
    "capture_ids": { "type": "array", "minItems": 1 },
    "targets": { "type": "array", "minItems": 1 },
    "source_governance": { "type": "array", "minItems": 1 },
    "graph_citations": { "type": "array", "minItems": 1 },
    "layout_constraints": { "type": "array" },
    "states": { "type": "object" },
    "responsive_rules": { "type": "object" },
    "interactions": { "type": "array" },
    "motion": { "type": "object" },
    "graphics": { "type": "object" },
    "design_system": { "type": "object" },
    "accessibility": { "type": "array" },
    "uncertainty": { "type": "array" },
    "limitations": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
