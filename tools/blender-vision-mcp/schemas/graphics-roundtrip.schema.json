{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/graphics-roundtrip.schema.json",
  "title": "VisionMCP browser graphics to Blender round-trip report",
  "type": "object",
  "required": [
    "schema",
    "id",
    "capture_id",
    "authority",
    "source_gltf_digest",
    "blend_digest",
    "output_glb_digest",
    "scene_id",
    "import",
    "inventory",
    "export",
    "reimport",
    "validation",
    "camera_comparison",
    "material_comparison",
    "fixed_frame_residual",
    "performance_comparison",
    "accepted",
    "acceptance_blockers",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.graphics-roundtrip/v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "DERIVED" },
    "source_gltf_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blend_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_glb_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scene_id": { "type": "string" },
    "import": { "type": "object" },
    "inventory": { "type": "object" },
    "export": { "type": "object" },
    "reimport": { "type": "object" },
    "validation": { "type": "object" },
    "camera_comparison": { "type": "object" },
    "material_comparison": { "type": "object" },
    "fixed_frame_residual": { "type": "object" },
    "performance_comparison": { "type": "object" },
    "accepted": { "const": false },
    "acceptance_blockers": { "type": "array", "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
