{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/blender-job.schema.json",
  "title": "Blender Vision safe worker job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "project_root",
    "scene_path",
    "result_path",
    "parameters",
    "safe_mode",
    "limits",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": {
      "enum": [
        "inspect_scene",
        "validate_scene",
        "import_asset",
        "create_component",
        "update_component",
        "apply_constraints",
        "create_camera",
        "apply_camera_solution",
        "render_passes",
        "export_glb",
        "export_blend",
        "generate_lod",
        "save_checkpoint",
        "repair_mac_studio_grille",
        "generate_components",
        "generate_synthetic_dataset",
        "generate_calibration_benchmark"
      ]
    },
    "project_root": { "type": "string" },
    "scene_path": { "type": "string" },
    "result_path": { "type": "string" },
    "parameters": { "type": "object" },
    "safe_mode": { "const": true },
    "limits": {
      "type": "object",
      "required": ["max_output_bytes"],
      "properties": { "max_output_bytes": { "type": "integer", "minimum": 1 } }
    },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
