{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/receipt.schema.json",
  "title": "Blender Vision acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_sha256"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["schema_version", "receipt_id", "created_at", "project", "runtime", "evidence", "acceptance"]
    },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
