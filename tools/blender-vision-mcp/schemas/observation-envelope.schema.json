{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/observation-envelope.schema.json",
  "title": "VisionMCP observation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "authority",
    "request",
    "artifacts",
    "summary",
    "limitations",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.observation-envelope/v1" },
    "capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "OBSERVED" },
    "request": {
      "type": "object",
      "required": [
        "adapter",
        "adapter_version",
        "target",
        "configuration",
        "environment",
        "rights_decision",
        "source_id"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "digest", "media_type", "metadata", "created_at"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "summary": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
