{
  "$defs": {
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "forward_axis": {
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ],
          "type": "string"
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin_semantics": {
          "type": "string"
        },
        "scale_authority": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER_SPEC",
            "SENSOR_DERIVED",
            "MODEL_DERIVED",
            "PROCEDURAL_GROUND_TRUTH",
            "RUNTIME_OBSERVED",
            "HUMAN_REVIEWED",
            "INFERRED",
            "HYPOTHETICAL",
            "UNRESOLVED",
            "REJECTED"
          ],
          "type": "string"
        },
        "units": {
          "enum": [
            "m",
            "mm",
            "px",
            "normalized",
            "deg",
            "rad",
            "s",
            "unitless"
          ],
          "type": "string"
        },
        "up_axis": {
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ],
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "CriticFinding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_test": {
          "type": "string"
        },
        "blast_radius": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bounded_repair": {
          "additionalProperties": true,
          "type": "object"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "critic_role": {
          "type": "string"
        },
        "diagnosis": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "finding_id": {
          "type": "string"
        },
        "likely_cause": {
          "type": "string"
        },
        "measured": {
          "additionalProperties": true,
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "minor",
            "major",
            "critical"
          ],
          "type": "string"
        }
      },
      "required": [
        "critic_role",
        "diagnosis",
        "finding_id"
      ],
      "type": "object"
    },
    "DeliveryAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "chapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "compression": {
          "type": "string"
        },
        "decode_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "lod": {
          "type": "string"
        },
        "main_thread_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "poster",
            "shell",
            "detail",
            "mobile",
            "network",
            "terminal",
            "texture"
          ],
          "type": "string"
        },
        "visual_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "bytes",
        "digest",
        "path",
        "role"
      ],
      "type": "object"
    },
    "LightingHypothesis": {
      "additionalProperties": false,
      "properties": {
        "atmosphere": {
          "additionalProperties": true,
          "type": "object"
        },
        "authority": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER_SPEC",
            "SENSOR_DERIVED",
            "MODEL_DERIVED",
            "PROCEDURAL_GROUND_TRUTH",
            "RUNTIME_OBSERVED",
            "HUMAN_REVIEWED",
            "INFERRED",
            "HYPOTHETICAL",
            "UNRESOLVED",
            "REJECTED"
          ],
          "type": "string"
        },
        "bloom": {
          "type": "number"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "contact_shadow": {
          "additionalProperties": true,
          "type": "object"
        },
        "depth_falloff": {
          "type": "number"
        },
        "environment": {
          "additionalProperties": true,
          "type": "object"
        },
        "exposure": {
          "type": "number"
        },
        "fill": {
          "additionalProperties": true,
          "type": "object"
        },
        "hypothesis_id": {
          "type": "string"
        },
        "key": {
          "additionalProperties": true,
          "type": "object"
        },
        "negative_fill": {
          "additionalProperties": true,
          "type": "object"
        },
        "reflection_cards": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "rig_class": {
          "enum": [
            "product_studio",
            "black_architectural",
            "neutral_documentation",
            "indoor_practical",
            "outdoor_daylight",
            "cinematic_corridor",
            "soft_organic"
          ],
          "type": "string"
        },
        "rim": {
          "additionalProperties": true,
          "type": "object"
        },
        "shadow_softness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "tone_map": {
          "type": "string"
        },
        "white_balance_k": {
          "maximum": 20000.0,
          "minimum": 1000.0,
          "type": "number"
        }
      },
      "required": [
        "hypothesis_id"
      ],
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "additionalProperties": true,
          "type": "object"
        },
        "hardware": {
          "additionalProperties": true,
          "type": "object"
        },
        "input_authorities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "operation": {
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "type": "object"
        },
        "retrieved_at": {
          "type": "string"
        },
        "rights_state": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "MaterialHypothesis": {
      "additionalProperties": false,
      "properties": {
        "anisotropy": {
          "maximum": 1.0,
          "minimum": -1.0,
          "type": "number"
        },
        "authority": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER_SPEC",
            "SENSOR_DERIVED",
            "MODEL_DERIVED",
            "PROCEDURAL_GROUND_TRUTH",
            "RUNTIME_OBSERVED",
            "HUMAN_REVIEWED",
            "INFERRED",
            "HYPOTHETICAL",
            "UNRESOLVED",
            "REJECTED"
          ],
          "type": "string"
        },
        "base_colour": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "clearcoat": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "clearcoat_roughness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "displacement_bands": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "emission": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "evidence_views": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hypothesis_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "metalness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "normal_bands": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "occlusion": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "renderer_parity": {
          "additionalProperties": true,
          "type": "object"
        },
        "roughness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "specular_ior": {
          "maximum": 4.0,
          "minimum": 1.0,
          "type": "number"
        },
        "subsurface": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "subsurface_radius": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "texture_coordinate_hypothesis": {
          "type": "string"
        },
        "texture_scale_m": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "transmission": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "hypothesis_id"
      ],
      "type": "object"
    },
    "NarrativeBeat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "type": "string"
        },
        "dwell": {
          "minimum": 0.0,
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "reduced_motion_view": {
          "additionalProperties": true,
          "type": "object"
        },
        "scroll_end": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "scroll_start": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "skippable": {
          "type": "boolean"
        },
        "text": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text_zone": {
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "label",
        "scroll_end",
        "scroll_start"
      ],
      "type": "object"
    },
    "ReconstructionCandidate": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "authority": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER_SPEC",
            "SENSOR_DERIVED",
            "MODEL_DERIVED",
            "PROCEDURAL_GROUND_TRUTH",
            "RUNTIME_OBSERVED",
            "HUMAN_REVIEWED",
            "INFERRED",
            "HYPOTHETICAL",
            "UNRESOLVED",
            "REJECTED"
          ],
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "coverage": {
          "additionalProperties": true,
          "type": "object"
        },
        "dimensional_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "editability": {
          "type": "string"
        },
        "executed": {
          "type": "boolean"
        },
        "execution_log": {
          "type": "string"
        },
        "failure_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frame": {
          "$ref": "#/$defs/CoordinateFrame"
        },
        "hidden_surface_assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "licensing": {
          "type": "string"
        },
        "material_state": {
          "type": "string"
        },
        "runtime_cost": {
          "additionalProperties": true,
          "type": "object"
        },
        "scale_authority": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER_SPEC",
            "SENSOR_DERIVED",
            "MODEL_DERIVED",
            "PROCEDURAL_GROUND_TRUTH",
            "RUNTIME_OBSERVED",
            "HUMAN_REVIEWED",
            "INFERRED",
            "HYPOTHETICAL",
            "UNRESOLVED",
            "REJECTED"
          ],
          "type": "string"
        },
        "scale_state": {
          "type": "string"
        },
        "topology_state": {
          "additionalProperties": true,
          "type": "object"
        },
        "visual_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "backend",
        "candidate_id"
      ],
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string"
        },
        "interval": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "kind": {
          "type": "string"
        },
        "samples": {
          "type": "integer"
        },
        "sigma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "units": {
          "enum": [
            "m",
            "mm",
            "px",
            "normalized",
            "deg",
            "rad",
            "s",
            "unitless"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://computexchange.dev/visionmcp/schemas/v2/scene-evidence-graph.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Unifies object, camera, geometry, material, light, visibility, uncertainty.",
  "properties": {
    "authority": {
      "enum": [
        "OBSERVED",
        "MEASURED",
        "MANUFACTURER_SPEC",
        "SENSOR_DERIVED",
        "MODEL_DERIVED",
        "PROCEDURAL_GROUND_TRUTH",
        "RUNTIME_OBSERVED",
        "HUMAN_REVIEWED",
        "INFERRED",
        "HYPOTHETICAL",
        "UNRESOLVED",
        "REJECTED"
      ],
      "type": "string"
    },
    "cameras": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "created_at": {
      "minLength": 20,
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "edges": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "frame": {
      "$ref": "#/$defs/CoordinateFrame"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "REJECTED",
        "ACCEPTED",
        "PROMOTED",
        "SUPERSEDED"
      ],
      "type": "string"
    },
    "lights": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "materials": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observation_bundles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "record_kind": {
      "const": "v2.scene-evidence-graph",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "type": "string"
    },
    "semantic_parts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "uncertainty": {
      "$ref": "#/$defs/Uncertainty"
    },
    "visibility": {
      "additionalProperties": {
        "enum": [
          "DIRECTLY_VISIBLE",
          "PARTIALLY_VISIBLE",
          "INFERRED_SURFACE",
          "NEVER_OBSERVED",
          "SYMMETRY_DERIVED",
          "TOPOLOGY_PRIOR",
          "RETRIEVED_MODEL"
        ],
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "authority",
    "created_at",
    "digest",
    "frame",
    "id",
    "nodes",
    "record_kind",
    "schema_version"
  ],
  "title": "SceneEvidenceGraph",
  "type": "object"
}
