{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/layout-graph.schema.json",
  "title": "VisionMCP LayoutGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graph_type",
    "authority",
    "coordinate_space",
    "capture",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": { "const": "vision.layout-graph/v1" },
    "graph_type": { "const": "LayoutGraph" },
    "authority": { "const": "OBSERVED" },
    "coordinate_space": { "const": "CSS viewport pixels" },
    "capture": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "selector",
          "tag",
          "bounds",
          "styles",
          "sourceBinding",
          "surface",
          "interactive",
          "depth"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": { "enum": ["CONTAINS", "USES_ASSET", "LABELS", "CONTROLS"] }
        }
      }
    }
  }
}
