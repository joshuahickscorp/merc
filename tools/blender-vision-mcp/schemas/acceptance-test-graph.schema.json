          "title": "Level",
          "type": "string"
        },
        "operation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Operation Ids",
          "type": "array"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "route_ids": {
