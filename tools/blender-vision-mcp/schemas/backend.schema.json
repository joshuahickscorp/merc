{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/backend.schema.json",
  "title": "Vision backend capability",
  "type": "object",
  "required": ["name", "license", "state", "outputs", "hardware"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": ["string", "null"] },
    "revision": { "type": ["string", "null"] },
    "license": { "type": "string" },
    "commercial_use": { "type": ["boolean", "null"] },
    "redistribution": { "type": ["boolean", "null"] },
    "state": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "RESEARCH_ONLY",
        "LICENSE_REVIEW_REQUIRED",
        "DOWNLOAD_REQUIRED",
        "INCOMPATIBLE_HARDWARE"
      ]
    },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "hardware": { "type": "array", "items": { "type": "string" } }
  }
}

