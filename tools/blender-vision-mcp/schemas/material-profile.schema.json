{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/material-profile.schema.json",
  "title": "Evidence-bound material appearance profile",
  "type": "object",
  "required": [
    "id",
    "region_id",
    "properties",
    "evidence",
    "confidence",
    "uncertainty",
    "authority",
    "status",
    "approval"
  ],
  "properties": {
    "id": { "type": "string" },
    "region_id": { "type": "string", "minLength": 1 },
    "component_id": { "type": ["string", "null"] },
    "material_slot": { "type": ["string", "null"] },
    "properties": {
      "type": "object",
      "required": [
        "base_color",
        "roughness",
        "metallic",
        "anisotropy",
        "clearcoat",
        "normal_detail",
        "procedural_texture"
      ],
      "properties": {
        "base_color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropy": { "type": "number", "minimum": 0, "maximum": 1 },
        "clearcoat": { "type": "number", "minimum": 0, "maximum": 1 },
        "normal_detail": { "type": "object" },
        "procedural_texture": { "type": "object" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "reference_ids",
        "artifact_digests",
        "reflective_region_mask_digests",
        "multi_light_reference_ids",
        "evidence_class"
      ],
      "properties": {
        "reference_ids": { "type": "array", "items": { "type": "string" } },
        "artifact_digests": { "type": "array", "items": { "type": "string" } },
        "reflective_region_mask_digests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "multi_light_reference_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_class": {
          "enum": [
            "MEASURED",
            "MANUFACTURER_SPEC",
            "MULTI_VIEW_OBSERVED",
            "SINGLE_VIEW_OBSERVED",
            "TEARDOWN_OBSERVED",
            "INFERRED_HIGH_CONFIDENCE",
            "INFERRED_LOW_CONFIDENCE",
            "OCCLUDED",
            "UNSEEN"
          ]
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "object" },
    "color_calibration": { "type": "object" },
    "lighting_estimate": { "type": "object" },
    "authority": {
      "type": "object",
      "required": ["appearance_only", "may_establish_geometry", "geometry_passes"],
      "properties": {
        "appearance_only": { "const": true },
        "may_establish_geometry": { "const": false },
        "rgb_excluded_from_geometry_gates": { "const": true },
        "geometry_passes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "enum": ["proposed", "approved", "rejected"] },
    "approval": { "type": "object" },
    "supersedes_id": { "type": ["string", "null"] }
  }
}
