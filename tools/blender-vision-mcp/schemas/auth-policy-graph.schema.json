{
  "$defs": {
    "PermissionSpec": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "resource",
        "actions"
      ],
      "title": "PermissionSpec",
      "type": "object"
    },
    "RoleSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "permission_ids": {
          "items": {
            "type": "string"
          },
          "title": "Permission Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "permission_ids"
      ],
      "title": "RoleSpec",
      "type": "object"
    }
  },
  "$id": "https://compute.exchange/schemas/auth-policy-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_refs": {
      "items": {
        "type": "string"
      },
      "title": "Authority Refs",
      "type": "array"
    },
    "credential_storage_policy": {
      "title": "Credential Storage Policy",
      "type": "string"
    },
    "cross_tenant_policy": {
      "title": "Cross Tenant Policy",
      "type": "string"
    },
    "default_role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default Role"
    },
    "deny_by_default": {
      "title": "Deny By Default",
      "type": "boolean"
    },
    "identity_claim": {
      "title": "Identity Claim",
      "type": "string"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/PermissionSpec"
      },
      "title": "Permissions",
      "type": "array"
    },
    "provider": {
      "enum": [
        "none",
        "test_header",
        "oidc",
        "oauth2",
        "signed_session",
        "api_key"
      ],
      "title": "Provider",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/RoleSpec"
      },
      "title": "Roles",
      "type": "array"
    },
    "session_lifetime_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Lifetime Seconds"
    },
    "tenant_claim": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Claim"
    }
  },
  "required": [
    "provider",
    "identity_claim",
    "roles",
    "permissions",
    "default_role",
    "deny_by_default",
    "cross_tenant_policy",
    "credential_storage_policy",
    "authority_refs"
  ],
  "title": "AuthPolicyGraph",
  "type": "object"
}
