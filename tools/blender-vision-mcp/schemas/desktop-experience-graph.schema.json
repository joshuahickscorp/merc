{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/desktop-experience-graph.schema.json",
  "title": "VisionMCP DesktopExperienceGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graph_type",
    "authority",
    "application",
    "window_title",
    "nodes",
    "edges",
    "windows"
  ],
  "properties": {
    "schema": { "const": "vision.desktop-experience-graph/v1" },
    "graph_type": { "const": "DesktopExperienceGraph" },
    "authority": { "const": "MIXED" },
    "application": { "type": "string" },
    "window_title": { "type": "string" },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "windows": { "type": "array" }
  }
}
