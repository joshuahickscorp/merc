{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/feature-capsule.schema.json",
  "title": "VisionMCP clean-room Feature Capsule",
  "type": "object",
  "required": [
    "schema",
    "id",
    "authority",
    "semantic_purpose",
    "kind",
    "framework",
    "experience_ir_id",
    "target_evidence_digests",
    "clean_room_behavior",
    "design_token_mapping",
    "component_mapping",
    "accessibility_behavior",
    "performance_budget",
    "owned_asset_mappings",
    "implementation_interface",
    "framework_output",
    "test_fixture",
    "verification_thresholds",
    "known_limitations",
    "provenance",
    "rights_restrictions",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.feature-capsule/v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "DERIVED" },
    "semantic_purpose": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "framework": {
      "enum": [
        "react",
        "vanilla",
        "threejs",
        "react-three-fiber",
        "storybook",
        "blender-previs"
      ]
    },
    "experience_ir_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_evidence_digests": { "type": "array", "minItems": 1 },
    "clean_room_behavior": { "type": "object" },
    "design_token_mapping": { "type": "array" },
    "component_mapping": { "type": "array" },
    "accessibility_behavior": { "type": "array" },
    "performance_budget": { "type": "object" },
    "owned_asset_mappings": { "type": "array" },
    "implementation_interface": { "type": "object" },
    "framework_output": { "type": "object" },
    "test_fixture": { "type": "object" },
    "verification_thresholds": { "type": "object" },
    "known_limitations": { "type": "array" },
    "provenance": { "type": "object" },
    "rights_restrictions": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
