{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/component.schema.json",
  "title": "Parametric technical component",
  "type": "object",
  "required": ["id", "type", "parameters", "constraints", "evidence_bindings"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "enum": [
        "Body", "Panel", "Shell", "Cutout", "Port", "Button", "Screw", "Foot",
        "Fan", "BladeArray", "VentArray", "HoleArray", "Grille", "Bracket",
        "HeatSink", "Logo", "PCB"
      ]
    },
    "parameters": { "type": "object" },
    "constraints": { "type": "array" },
    "evidence_bindings": { "type": "array", "items": { "type": "string" } },
    "material_slots": { "type": "array", "items": { "type": "string" } },
    "lod_rules": { "type": "object" }
  }
}

