{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/design-drift.schema.json",
  "title": "VisionMCP design drift report",
  "type": "object",
  "required": [
    "schema",
    "id",
    "figma_capture_id",
    "storybook_capture_id",
    "authority",
    "status",
    "component_bindings",
    "missing_components",
    "missing_variants",
    "token_drift",
    "component_policy",
    "citations",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.design-drift/v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "figma_capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "storybook_capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "DERIVED" },
    "status": { "enum": ["PASS", "DRIFT_DETECTED"] },
    "component_bindings": { "type": "array" },
    "missing_components": { "type": "array" },
    "missing_variants": { "type": "array" },
    "token_drift": { "type": "array" },
    "component_policy": { "type": "object" },
    "citations": { "type": "array", "minItems": 2 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
