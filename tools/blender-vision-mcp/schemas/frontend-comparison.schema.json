{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/frontend-comparison.schema.json",
  "title": "VisionMCP frontend graph comparison",
  "type": "object",
  "required": [
    "schema",
    "id",
    "authority",
    "target_capture_id",
    "candidate_capture_id",
    "scope",
    "residuals",
    "metrics",
    "thresholds",
    "gates",
    "status",
    "citations",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "vision.frontend-comparison/v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "DERIVED" },
    "target_capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_capture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "type": "object" },
    "residuals": { "type": "array" },
    "metrics": { "type": "object" },
    "thresholds": { "type": "object" },
    "gates": { "type": "object" },
    "status": { "enum": ["PASS", "FAIL"] },
    "citations": { "type": "array", "minItems": 2 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
