{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/worker-capability.schema.json",
  "title": "Blender Vision distributed worker capability",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "hardware",
    "vram_gb",
    "system_memory_gb",
    "supported_models",
    "render_devices",
    "capabilities"
  ],
  "properties": {
    "hardware": {"type": "array", "items": {"type": "string"}},
    "vram_gb": {"type": "number", "minimum": 0},
    "system_memory_gb": {"type": "number", "minimum": 0},
    "supported_models": {"type": "array", "items": {"type": "string"}},
    "blender_version": {"type": ["string", "null"]},
    "render_devices": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}}
  }
}
