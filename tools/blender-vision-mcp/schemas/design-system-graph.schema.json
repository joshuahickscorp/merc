{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/design-system-graph.schema.json",
  "title": "VisionMCP DesignSystemGraph",
  "type": "object",
  "required": [
    "schema",
    "graph_type",
    "authority",
    "source_kind",
    "source_revision",
    "nodes",
    "edges",
    "tokens"
  ],
  "properties": {
    "schema": { "const": "vision.design-system-graph/v1" },
    "graph_type": { "const": "DesignSystemGraph" },
    "authority": { "const": "OBSERVED" },
    "source_kind": { "enum": ["figma", "storybook"] },
    "source_revision": {},
    "source_security": {
      "type": "object",
      "required": [
        "sha256",
        "size",
        "node_count",
        "string_bytes",
        "prompt_injection_findings",
        "instruction_authority"
      ],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "node_count": { "type": "integer", "minimum": 1 },
        "string_bytes": { "type": "integer", "minimum": 0 },
        "prompt_injection_findings": { "type": "integer", "minimum": 0 },
        "instruction_authority": { "const": false }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain_type",
          "spatial_bounds",
          "temporal_validity",
          "evidence_references",
          "authority",
          "confidence",
          "source_restrictions",
          "uncertainty",
          "revision_lineage",
          "name",
          "semantic_name"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "authority", "evidence_references"]
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "semantic_name", "kind", "value", "authority"]
      }
    }
  }
}
