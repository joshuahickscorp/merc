{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/video-narrative-graph.schema.json",
  "title": "VisionMCP VideoNarrativeGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graph_type",
    "authority",
    "source_digest",
    "nodes",
    "edges",
    "tracks",
    "scenes",
    "camera_motion",
    "depth",
    "metadata"
  ],
  "properties": {
    "schema": { "const": "vision.video-narrative-graph/v1" },
    "graph_type": { "const": "VideoNarrativeGraph" },
    "authority": { "const": "MIXED" },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "tracks": { "type": "array" },
    "scenes": { "type": "array", "minItems": 1 },
    "camera_motion": { "type": "array" },
    "depth": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "UNAVAILABLE" },
        "reason": { "type": "string" }
      }
    },
    "metadata": { "type": "object" }
  }
}
