{
  "$defs": {
    "DataEntity": {
      "additionalProperties": false,
      "properties": {
        "contains_sensitive_data": {
          "default": false,
          "title": "Contains Sensitive Data",
          "type": "boolean"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/DataField"
          },
          "title": "Fields",
          "type": "array"
        },
        "indexes": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Indexes",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "retention_policy": {
          "title": "Retention Policy",
          "type": "string"
        },
        "table_name": {
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "table_name",
        "fields",
        "retention_policy"
      ],
      "title": "DataEntity",
      "type": "object"
    },
    "DataField": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "datetime",
            "json",
            "binary",
            "uuid"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "primary_key": {
          "default": false,
          "title": "Primary Key",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "validation": {
          "additionalProperties": true,
          "title": "Validation",
          "type": "object"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "title": "DataField",
      "type": "object"
    },
    "DataRelation": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "from_entity": {
          "title": "From Entity",
          "type": "string"
        },
        "from_field": {
          "title": "From Field",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "on_delete": {
          "enum": [
            "restrict",
            "cascade",
            "set_null"
          ],
          "title": "On Delete",
          "type": "string"
        },
        "to_entity": {
          "title": "To Entity",
          "type": "string"
        },
        "to_field": {
          "title": "To Field",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_entity",
        "from_field",
        "to_entity",
        "to_field",
        "cardinality",
        "on_delete"
      ],
      "title": "DataRelation",
      "type": "object"
    }
  },
  "$id": "https://compute.exchange/schemas/data-model-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_refs": {
      "items": {
        "type": "string"
      },
      "title": "Authority Refs",
      "type": "array"
    },
    "database_engine": {
      "enum": [
        "sqlite",
        "postgresql"
      ],
      "title": "Database Engine",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/DataEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "migration_policy": {
      "title": "Migration Policy",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/DataRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "rollback_policy": {
      "title": "Rollback Policy",
      "type": "string"
    },
    "seed_policy": {
      "title": "Seed Policy",
      "type": "string"
    }
  },
  "required": [
    "database_engine",
    "entities",
    "relations",
    "seed_policy",
    "migration_policy",
    "rollback_policy",
    "authority_refs"
  ],
  "title": "DataModelGraph",
  "type": "object"
}
