{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision-mcp.dev/schemas/component-fit.schema.json",
  "title": "Evidence-bound parametric component fit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "inputs",
    "result",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["proposed", "accepted", "rejected"]},
    "inputs": {
      "type": "object",
      "required": [
        "component_id",
        "component_revision",
        "parameter_bindings",
        "huber_delta"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_revision": {"type": "integer", "minimum": 1},
        "parameter_bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "huber_delta": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "result": {
      "type": "object",
      "required": [
        "candidate_parameters",
        "parameter_reports",
        "constraint_checks",
        "constraints_pass",
        "release_eligible_evidence",
        "requires_named_review"
      ],
      "properties": {
        "candidate_parameters": {"type": "object"},
        "parameter_reports": {"type": "object"},
        "constraint_checks": {"type": "array", "items": {"type": "object"}},
        "constraints_pass": {"type": "boolean"},
        "release_eligible_evidence": {"type": "boolean"},
        "requires_named_review": {"const": true}
      }
    },
    "reviewer": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "applied_revision": {"type": ["integer", "null"], "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
