{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/responsive-graph.schema.json",
  "title": "VisionMCP ResponsiveGraph",
  "type": "object",
  "required": [
    "schema",
    "graph_type",
    "authority",
    "target",
    "nodes",
    "edges",
    "input_mode_variants"
  ],
  "properties": {
    "schema": { "const": "vision.responsive-graph/v1" },
    "graph_type": { "const": "ResponsiveGraph" },
    "authority": { "const": "OBSERVED" },
    "target": { "type": "object" },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain_type",
          "spatial_bounds",
          "temporal_validity",
          "evidence_references",
          "authority",
          "confidence",
          "source_restrictions",
          "uncertainty",
          "revision_lineage",
          "viewport",
          "elements"
        ]
      }
    },
    "edges": { "type": "array" },
    "input_mode_variants": { "type": "object" }
  }
}
