{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-vision.dev/schemas/feature.schema.json",
  "title": "Evidence-bound technical feature",
  "type": "object",
  "required": [
    "id",
    "type",
    "parent_component",
    "coordinate_frame",
    "observations",
    "confidence",
    "uncertainty",
    "evidence_class",
    "human_approval"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "parent_component": { "type": ["string", "null"] },
    "dimensions": { "type": "object" },
    "coordinate_frame": { "type": "string" },
    "observations": { "type": "array" },
    "reference_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "object" },
    "evidence_class": {
      "enum": [
        "MEASURED",
        "MANUFACTURER_SPEC",
        "MULTI_VIEW_OBSERVED",
        "SINGLE_VIEW_OBSERVED",
        "TEARDOWN_OBSERVED",
        "INFERRED_HIGH_CONFIDENCE",
        "INFERRED_LOW_CONFIDENCE",
        "OCCLUDED",
        "UNSEEN"
      ]
    },
    "model_revision": { "type": ["string", "null"] },
    "human_approval": { "type": "boolean" },
    "coverage_group": { "type": ["string", "null"] },
    "hero_surface": { "type": "boolean" },
    "provenance": { "type": "array", "items": { "type": "object" } },
    "approval": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "reviewed_at": { "type": "string" }
      }
    },
    "lifecycle_state": { "enum": ["active", "superseded", "rejected"] },
    "superseded_by": { "type": ["string", "null"] }
  }
}
