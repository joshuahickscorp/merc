{
  "name": "nocturne-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts",
    "test:3d": "node scripts/verify-3d.mjs",
    "test:browser": "tsx tests/browser.test.ts",
    "verify": "npm run typecheck && npm run build && npm run test:unit && npm run test:api && npm run test:3d && npm run test:browser",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "start": "npm run build --silent && tsx src/server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "compression": "1.8.1",
    "express": "4.21.2",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/three": "0.179.0",
    "playwright": "1.54.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
