{
  "schema": "visionmcp.object-benchmark-resumption/v1",
  "target_id": "animal_bust",
  "phase": "P_fur",
  "status": "synthetic_ground_truth_only",
  "synthetic_claim": "Synthetic target with known construction parameters. This is not evidence about any real animal; the real-animal lane remains blocked on an authorized multiview capture set.",
  "required_to_resume_real_animal": {
    "authorization": "Written authorization that the multiview set may be captured and processed for this project.",
    "subject": "Live or specimen animal clearly identified; not reconstructed from stock photos without rights.",
    "multiview_images": {
      "min_count": 36,
      "min_short_side_px": 2000,
      "coverage": ["left", "right", "front", "rear", "top", "three_quarter"],
      "groom_state": "document wet/dry/brushed condition"
    },
    "scale_reference": true,
    "calibration_target": "recommended",
    "ethics_and_rights": {
      "required": true,
      "fields": ["consent_or_permit_id", "rights_state", "retention_policy"]
    },
    "hidden_surface_policy": {
      "unobserved_regions": "NEVER_OBSERVED",
      "never_label_as": ["OBSERVED"]
    }
  },
  "inputs_to_place": {
    "directory": "artifacts/v2/object-benchmarks/organic/animal_bust/real_capture/",
    "authorization": "authorization.json",
    "images": "images/",
    "scale_reference": "scale_reference.json"
  },
  "synthetic_lane_command": "python scripts/run-organic-fur-lane.py --output artifacts/v2/organic",
  "benchmark_command": "python scripts/run-object-benchmarks.py --output artifacts/v2/object-benchmarks"
}
