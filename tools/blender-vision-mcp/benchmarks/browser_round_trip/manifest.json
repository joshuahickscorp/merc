{
  "acceptance_thresholds": {
    "blend_reopen_required": true,
    "critical_accessibility_violations_maximum": 0,
    "dom_structure_match_required": true,
    "glb_reimport_required": true,
    "hidden_pixel_rmse_maximum": 18.0,
    "max_playwright_browsers": 1,
    "public_pixel_rmse_maximum": 12.0
  },
  "anti_cheat_rules": [
    "builder_cannot_read_oracle_source",
    "builder_cannot_read_hidden_cameras",
    "builder_cannot_path_escape_to_oracle",
    "builder_cannot_symlink_into_oracle",
    "thresholds_are_digest_bound_before_builder_execution",
    "evaluator_is_frozen_before_builder_and_reverified_after",
    "hidden_evidence_never_appears_in_builder_inputs",
    "failed_attempts_are_preserved",
    "blocked_evidence_is_declared_exactly_never_substituted"
  ],
  "blocked_requirements": [],
  "builder_inputs": [
    {
      "builder_visible": true,
      "description": "Owned HTML fixture entry",
      "path": "builder_inputs/fixture/index.html",
      "required": true,
      "role": "fixture"
    },
    {
      "builder_visible": true,
      "description": "Public scene description for the fixture",
      "path": "builder_inputs/fixture/scene.json",
      "required": true,
      "role": "fixture"
    },
    {
      "builder_visible": true,
      "description": "Declared round-trip acceptance protocol",
      "path": "builder_inputs/round_trip_protocol.json",
      "required": true,
      "role": "protocol"
    }
  ],
  "claim_boundary": [
    "Thresholds apply to the owned browser fixture only.",
    "At most one Playwright browser may be alive during evaluation.",
    "Chrome/Blender sandbox failures must be reported blocked, not faked."
  ],
  "description": "Owned web scene capture, glTF materialization, Blender import/export, and browser re-instantiation. Builder receives the public fixture packet; oracle retains hidden interaction traces and evaluator DOM/WebGL probes.",
  "display_name": "Browser \u2192 Blender \u2192 browser round trip",
  "evaluator": {
    "entry": "evaluator/gates.json",
    "roles": [
      "browser",
      "gltf",
      "accessibility"
    ],
    "root": "evaluator"
  },
  "evidence_status": "available",
  "hidden_evidence": [
    {
      "builder_visible": false,
      "description": "Hidden WebGL frame holdout",
      "path": "oracle/hidden/cameras/webgl_holdout.json",
      "required": true,
      "role": "hidden_camera"
    },
    {
      "builder_visible": false,
      "description": "Oracle DOM/AX snapshot for evaluator",
      "path": "oracle/hidden/measurements/dom_ax_snapshot.json",
      "required": true,
      "role": "hidden_measurement"
    },
    {
      "builder_visible": false,
      "description": "Evaluator-only interaction trace",
      "path": "oracle/hidden/interaction/hidden_trace.json",
      "required": true,
      "role": "hidden_trace"
    },
    {
      "builder_visible": false,
      "description": "Leakage canary",
      "path": "oracle/hidden/ORACLE_CANARY.txt",
      "required": true,
      "role": "canary"
    }
  ],
  "kind": "v2.sealed-benchmark-manifest",
  "schema_version": "1",
  "subsystems": [
    "active_perception",
    "delivery",
    "critics"
  ],
  "target_id": "browser_round_trip"
}
