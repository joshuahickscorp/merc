{
  "name": "ocular_proposal_fusion_splits",
  "version": "1.0.0",
  "description": "Single split authority for the multi-source region proposal ensemble. Calibration, public development, and sealed hidden partitions are frozen here. Detector thresholds and fusion weights are digest-bound before any hidden evaluation. Never recompute hidden indices.",
  "anti_cheat_rules": [
    "builder_cannot_read_hidden_labels_boxes_identities_masks_or_scores",
    "builder_cannot_read_hidden_canary",
    "thresholds_are_digest_bound_before_hidden_run",
    "hidden_indices_are_never_recomputed",
    "leakage_canary_must_be_absent_from_builder_inputs"
  ],
  "conditions": [
    "visually_similar",
    "crossing_paths",
    "partial_occlusion",
    "full_occlusion",
    "lighting_change",
    "scale_change",
    "camera_motion",
    "leave_return",
    "distractor_replacement",
    "unknown_entering",
    "permanence"
  ],
  "splits": {
    "calibration": {
      "description": "Tune classical thresholds only on these conditions. No hidden access.",
      "conditions": [
        "visually_similar",
        "crossing_paths",
        "partial_occlusion",
        "lighting_change"
      ],
      "builder_visible": true
    },
    "public_development": {
      "description": "Public regression set. Metrics may be published. Still no hidden labels.",
      "conditions": [
        "full_occlusion",
        "scale_change",
        "camera_motion",
        "leave_return"
      ],
      "builder_visible": true
    },
    "sealed_hidden": {
      "description": "Sealed evaluation only. Builder must never open labels, boxes, identities, masks, or scores. Indices are frozen here.",
      "conditions": [
        "distractor_replacement",
        "unknown_entering",
        "permanence"
      ],
      "builder_visible": false,
      "indices_frozen": true,
      "hidden_relative_paths": [
        "hidden/ORACLE_CANARY.txt",
        "hidden/labels.json"
      ]
    }
  },
  "first_frame_stationary": {
    "description": "Acceptance bar: three stationary similar objects in frame 1 with no temporal evidence must yield three proposals.",
    "condition": "visually_similar",
    "frame_index": 0,
    "min_proposals": 3,
    "expected_object_count": 3
  },
  "frozen_thresholds": {
    "min_area": 40,
    "max_regions_per_source": 24,
    "overlap_iou_edge": 0.15,
    "appearance_agree_edge": 0.55,
    "split_circularity_max": 0.72,
    "split_aspect_min": 1.55,
    "split_peak_min_sep_px": 8,
    "merge_centroid_dist_scale": 1.8,
    "merge_appearance_min": 0.7,
    "merge_gap_px": 12,
    "background_threshold": 18,
    "residual_threshold": 12,
    "flow_mag_threshold": 0.8,
    "point_cluster_min_points": 3,
    "point_motion_eps": 0.6,
    "point_spatial_eps": 28.0,
    "edge_dilate_px": 2,
    "local_contrast_percentile": 88.0,
    "fused_recall_min": 0.5,
    "first_frame_min_proposals": 3,
    "confidence_floor": 0.15,
    "multi_source_bonus": 0.12
  },
  "frozen_thresholds_digest": "8af72274c46643429e95e97fe21473e0a1c6353896b2cb0ba6015e0313726d29",
  "acceptance": {
    "first_frame_min_proposals": 3,
    "fused_recall_min": 0.5,
    "declare_before_hidden": true
  },
  "builder_inputs": [
    {
      "path": "builder_inputs/README.md",
      "builder_visible": true,
      "role": "protocol"
    },
    {
      "path": "builder_inputs/public_conditions.json",
      "builder_visible": true,
      "role": "split_public"
    }
  ],
  "hidden_evidence": [
    {
      "path": "hidden/ORACLE_CANARY.txt",
      "builder_visible": false,
      "role": "canary"
    },
    {
      "path": "hidden/labels.json",
      "builder_visible": false,
      "role": "hidden_labels"
    }
  ],
  "sources": [
    "appearance",
    "temporal_change",
    "dense_features",
    "geometry",
    "point_track_clusters",
    "unknown_region"
  ],
  "notes": [
    "BackgroundModel is one source among several, never the sole detector.",
    "Geometry must report BLOCKED when no depth pass is available.",
    "Fusion preserves split and merge hypotheses; no winner-takes-all NMS."
  ]
}
