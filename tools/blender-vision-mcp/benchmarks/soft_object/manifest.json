{
  "acceptance_thresholds": {
    "critical_critic_findings_maximum": 0,
    "deformed_chamfer_m_maximum": 0.003,
    "hidden_silhouette_iou_minimum": 0.88,
    "material_hypothesis_count_minimum": 2,
    "public_silhouette_iou_minimum": 0.92,
    "rest_chamfer_m_maximum": 0.0015
  },
  "anti_cheat_rules": [
    "builder_cannot_read_oracle_source",
    "builder_cannot_read_hidden_cameras",
    "builder_cannot_path_escape_to_oracle",
    "builder_cannot_symlink_into_oracle",
    "thresholds_are_digest_bound_before_builder_execution",
    "evaluator_is_frozen_before_builder_and_reverified_after",
    "hidden_evidence_never_appears_in_builder_inputs",
    "failed_attempts_are_preserved",
    "blocked_evidence_is_declared_exactly_never_substituted"
  ],
  "blocked_requirements": [],
  "builder_inputs": [
    {
      "builder_visible": true,
      "description": "Public rest-state view metadata",
      "path": "builder_inputs/public_states/rest.json",
      "required": true,
      "role": "public_view"
    },
    {
      "builder_visible": true,
      "description": "Public deformed-state view metadata",
      "path": "builder_inputs/public_states/deformed.json",
      "required": true,
      "role": "public_view"
    },
    {
      "builder_visible": true,
      "description": "Public textile class labels only",
      "path": "builder_inputs/material_brief.json",
      "required": true,
      "role": "brief"
    }
  ],
  "claim_boundary": [
    "Thresholds apply to the owned soft-object fixture only.",
    "Material outputs must be hypothesis sets, not single forced labels."
  ],
  "description": "Cloth / soft-body reconstruction and material inference under controlled deformation. Builder receives public multi-state views; oracle retains rest-pose mesh, material node values, and hidden lighting.",
  "display_name": "Soft deformable object",
  "evaluator": {
    "entry": "evaluator/gates.json",
    "roles": [
      "geometry",
      "material",
      "critics"
    ],
    "root": "evaluator"
  },
  "evidence_status": "available",
  "hidden_evidence": [
    {
      "builder_visible": false,
      "description": "Hidden side holdout under deformation",
      "path": "oracle/hidden/cameras/holdout_side.json",
      "required": true,
      "role": "hidden_camera"
    },
    {
      "builder_visible": false,
      "description": "Oracle rest-pose mesh statistics",
      "path": "oracle/hidden/measurements/rest_mesh_stats.json",
      "required": true,
      "role": "hidden_measurement"
    },
    {
      "builder_visible": false,
      "description": "Oracle fabric BSDF parameters",
      "path": "oracle/hidden/materials/fabric_nodes.json",
      "required": true,
      "role": "hidden_material"
    },
    {
      "builder_visible": false,
      "description": "Leakage canary",
      "path": "oracle/hidden/ORACLE_CANARY.txt",
      "required": true,
      "role": "canary"
    }
  ],
  "kind": "v2.sealed-benchmark-manifest",
  "schema_version": "1",
  "subsystems": [
    "organic",
    "materials",
    "lighting",
    "critics",
    "reconstruction"
  ],
  "target_id": "soft_object"
}
