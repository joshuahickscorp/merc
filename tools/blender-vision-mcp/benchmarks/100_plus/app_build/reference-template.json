        "entity_refs": [
          "Item"
        ],
        "handler": {
          "entity_ref": "Item",
          "field_bindings": {
            "name": "name"
          },
          "id_field": "id",
          "kind": "create_entity"
        },
        "method": "POST",
        "operation_id": "createItem",
        "path": "/items",
        "rate_limit": "30/minute/actor",
        "request_fields": [
          {
            "data_type": "string",
            "location": "body",
            "name": "name",
            "required": true,
            "validation": {
              "maximum_length": 120,
              "minimum_length": 1
            }
          }
        ],
        "required_permissions": [
          "item.create"
        ],
        "responses": [
          {
            "description": "Created item",
            "schema_ref": "Item",
            "status": 201
          },
          {
            "description": "Denied",
            "status": 403
          }
        ],
        "summary": "Create item",
        "timeout_ms": 1000
      }
    ],
    "error_envelope": {
      "code": "stable machine code",
      "message": "safe human message",
      "request_id": "trace identifier"
