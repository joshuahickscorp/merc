          "Item"
        ],
        "handler": {
          "entity_ref": "Item",
          "field_bindings": {
            "name": "name"
          },
          "id_field": "id",
          "kind": "idempotent_create"
        },
        "idempotency": {
          "conflict_status": 409,
          "key_header": "idempotency-key",
          "replay_status": 200,
          "request_hash_required": true,
          "retention_seconds": 86400,
          "scope": "actor"
        },
        "method": "POST",
        "operation_id": "createReservation",
        "path": "/reservations",
        "rate_limit": "30/minute/actor",
        "request_fields": [
          {
            "data_type": "string",
            "location": "body",
            "name": "name",
            "required": true,
            "validation": {
              "maximum_length": 120,
              "minimum_length": 1
            }
          }
        ],
        "required_permissions": [
          "item.create"
        ],
        "responses": [
          {
            "description": "Created item",
            "schema_ref": "Item",
            "status": 201
          },
          {
            "description": "Denied",
            "status": 403
          }
        ],
        "summary": "Create reservation exactly once",
        "timeout_ms": 1000
      }
    ],
    "error_envelope": {
      "code": "stable machine code",
      "message": "safe human message",
      "request_id": "trace identifier"
