FROM golang:1.26.5@sha256:ae5a2316d12f3e78fd99177dad452e6ad4f240af2d71d57b480c3477f250fec6 AS build
ARG MERC_BUILD_VERSION=dev
ARG MERC_BUILD_COMMIT=unknown
ARG MERC_BUILD_DATE=unknown
WORKDIR /src/control
COPY control/go.mod control/go.sum ./
RUN go mod download
COPY control/ ./
COPY ops/healthcheck.c /tmp/healthcheck.c
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X main.controlVersion=${MERC_BUILD_VERSION} -X main.controlCommit=${MERC_BUILD_COMMIT} -X main.controlBuildDate=${MERC_BUILD_DATE} -X main.cliVersion=${MERC_BUILD_VERSION} -X main.cliCommit=${MERC_BUILD_COMMIT} -X main.cliBuildDate=${MERC_BUILD_DATE}" \
    -o /merc . && \
    cc -static -Os -s -Wall -Wextra -Werror -o /merc-healthcheck /tmp/healthcheck.c

FROM gcr.io/distroless/static:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6
ARG MERC_BUILD_VERSION=dev
ARG MERC_BUILD_COMMIT=unknown
ARG MERC_BUILD_DATE=unknown
LABEL org.opencontainers.image.title="merc control plane" \
      org.opencontainers.image.version="${MERC_BUILD_VERSION}" \
      org.opencontainers.image.revision="${MERC_BUILD_COMMIT}" \
      org.opencontainers.image.created="${MERC_BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/joshuahickscorp/merc"
WORKDIR /
COPY --from=build /merc /merc
COPY --from=build /merc-healthcheck /merc-healthcheck
# The release artifact.
#
# This image could not start. The catalogue price authority is read from
# pricing/board.json, the final stage is distroless with WORKDIR /, and this file
# copied the binary and three HTML pages -- so every candidate path missed and
# startup reached log.Fatalf("catalogue price authority unavailable"). The live
# host was up only because it had been assembled by hand, which means the revenue
# host could not be rebuilt from the repository.
#
# One absolute path, named by production configuration, digest reported on
# /version. Not another fallback: the more places a file can be found, the less a
# successful start says about which one was loaded.
COPY pricing/board.json /etc/merc/pricing/board.json
# Cited price receipts. The catalogue price authority resolves every
# SourceCitation at startup and refuses to publish a price whose receipt is
# missing or whose throughput disagrees, so the image must carry the receipts it
# cites or it cannot boot. 16K, and shipping them keeps that check live in
# production rather than only in a dev tree with git.
COPY evidence/benchmarks/ /etc/merc/evidence/benchmarks/
# Runtime-cell binding receipts (the g070 llama batch_infer r5 receipt and its
# siblings). BuildCataloguePriceSchedule cites these at startup to bind the
# published lane; without them the catalogue is empty and the control plane
# cannot boot. 232K, all real (LFS-smudged) content.
COPY evidence/perf/runtime-benchmarks/ /etc/merc/evidence/perf/runtime-benchmarks/

# The whole web surface, not the three pages that happened to be listed. The
# router serves /prices, /supplier, /assets/site/{path...} and
# /.well-known/security.txt, and none of those files were in the image -- a
# missing page is a 404 rather than a dead process, which is exactly why nobody
# noticed.
COPY web/ /web/
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/merc"]
