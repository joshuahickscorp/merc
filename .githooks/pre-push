#!/usr/bin/env bash
# Refuse to push a commit that has no push-eligible checkpoint receipt.
#
# The logic lives in `merc dev checkpoint-verify`; this hook is only the trigger,
# so the same rule can be run by hand, by a script, or by CI without depending on
# anyone's local hook configuration. Remote CI remains authoritative.
#
# Install once:  git config core.hooksPath .githooks
# Bypass:        git push --no-verify   (records nothing; use it knowingly)
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote branch pushes the all-zero local sha; nothing to verify.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if ! (cd "$root/control" && go run . dev checkpoint-verify --commit "$local_sha"); then
    echo "pre-push: refusing to push $local_sha without a checkpoint receipt." >&2
    echo "          cd control && go run . dev checkpoint" >&2
    status=1
  fi
  : "$remote_sha"
done
exit "$status"
