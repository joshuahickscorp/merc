DATABASE_URL=postgres://cx:cx@localhost:5432/cx?sslmode=disable
LISTEN_ADDR=:8080
MERC_PUBLIC_CONTROL_ORIGIN=http://localhost:8080
# Verification reserves three connections per concurrent processor, two for
# API/background work, and one for worker-leader election. 20 permits five
# verification processors; worker mode refuses to start below 6.
DB_MAX_CONNS=20

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=cx-jobs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

MERC_CONTROL_URL=http://localhost:8080
MERC_WORKER_TOKEN=replace-with-enrolled-worker-token
# MERC_MODEL_CACHE=/absolute/model/cache
# MERC_REQUIRE_SANDBOX=1
MERC_ENV=development
# Payment authority is explicit and fail-closed:
#   sealed = no provider network access or value movement (production default)
#   test   = sk_test_/rk_test_ only
#   live   = clean candidate + short-lived HMAC-bound activation evidence
MERC_PAYMENT_MODE=sealed
MERC_PAYMENT_PROVIDER=none
# Only directly connected reverse proxies may supply client-IP headers.
# MERC_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# MERC_TOKEN_KEY=at-least-32-random-bytes
# MERC_VERIFICATION_SAMPLE_SECRET=at-least-32-distinct-random-bytes

# Supervised private-canary envelope. Enabling canary mode without every limit
# and both explicit allowlists makes /readyz fail closed.
# MERC_CANARY_MODE=true
# MERC_CANARY_APPROVED_BUYER_EMAILS=buyer-one@example.test,buyer-two@example.test
# MERC_CANARY_APPROVED_WORKER_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002
# MERC_CANARY_APPROVED_AGENT_VERSIONS=0.1.0
# MERC_CANARY_APPROVED_BUILD_HASHES=0123456789abcdef,fedcba9876543210
# MERC_CANARY_MAX_ACTIVE_BUYERS=2
# MERC_CANARY_MAX_ACTIVE_WORKERS=2
# MERC_CANARY_MAX_QUEUED_JOBS=20
# MERC_CANARY_MAX_TASKS_PER_JOB=64
# MERC_CANARY_MAX_ARTIFACT_BYTES=33554432
# MERC_CANARY_MAX_INPUT_BYTES=33554432
# MERC_CANARY_MAX_OUTPUT_TOKENS=256
# MERC_CANARY_MAX_JOB_DURATION_SECS=600
# MERC_CANARY_MAX_RETRIES=3
# MERC_CANARY_MAX_DAILY_JOBS=100
# MERC_CANARY_MAX_SHADOW_VALUE_USD=10
# MERC_CANARY_MAX_HELD_SHADOW_PAYOUT_USD=10

# Ending the canary. MERC_CANARY_MODE=false also opens self-serve signup, so in
# production the reference must be the host path of a decision artifact (mounted
# into the container by docker-compose.prod.yml) plus the sha256 of its exact
# bytes. Outside production the reference is a free-text note, which is why the
# development example below is a bare string.
# MERC_CANARY_DISABLE_DECISION_SOURCE=/etc/merc/secrets/canary-disable-decision.json
# MERC_CANARY_DISABLE_DECISION_CONTAINER_FILE=/run/secrets/merc-canary-disable-decision.json
# MERC_CANARY_DISABLE_DECISION_SHA256=<sha256 of that file>
# MERC_CANARY_DISABLE_DECISION_REF=INC-1234-local-development

# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# MERC_CONNECT_WEBHOOK_SECRET=whsec_distinct_xxx
# MERC_CONNECT_CLIENT_ID=ca_xxx
# STRIPE_TEST_CONNECTED_ACCOUNT_ID=acct_xxx
# STRIPE_BILLING_WEBHOOK_ENDPOINT_ID=we_xxx
# STRIPE_CONNECT_WEBHOOK_ENDPOINT_ID=we_distinct_xxx
# LIVE only. The source is mounted read-only at the fixed container path by
# docker-compose.prod.yml. The HMAC key must be a separate, permission-restricted
# file; its value is never passed through the container environment. Approvals
# and the external aggregate-cap reference are signed inside the envelope.
# MERC_LIVE_PAYMENT_ACTIVATION_SOURCE=/absolute/private/live-payment-activation.json
# MERC_LIVE_PAYMENT_ACTIVATION_SHA256=64-lowercase-hex
# MERC_LIVE_PAYMENT_ACTIVATION_HMAC_KEY_SOURCE=/absolute/private/live-payment-activation-hmac-key
# LIVE production only; TEST may continue using STRIPE_SECRET_KEY directly.
# STRIPE_SECRET_KEY_SOURCE=/absolute/private/stripe-secret-key
MERC_CONNECT_RETURN_URL=http://localhost:8080/v1/supplier/status
MERC_CONNECT_REFRESH_URL=http://localhost:8080/v1/supplier/status

# Settlement currency for ledger, charges, payouts and receipts. Required.
# Must be a supported ISO code (usd, cad, jpy). No silent default — an unset
# value refuses boot. Match the Stripe platform's holdable balance currency.
MERC_SETTLEMENT_CURRENCY=cad
# The governed catalogue board is denominated in USD. When settlement is not
# USD, publication requires an operator-approved conversion rate (settlement
# major units per USD) and an immutable source/revision identifier. The control
# plane refuses boot rather than reusing the USD numbers as CAD.
MERC_PRICE_REFERENCE_TO_SETTLEMENT_RATE=REPLACE_WITH_APPROVED_RATE
MERC_PRICE_FX_REVISION=REPLACE_WITH_IMMUTABLE_SOURCE_REVISION

MERC_ECON_SCHEDULE_VERSION=2026-07-19
MERC_PROCESSOR_PERCENT_BPS=290
MERC_PROCESSOR_FIXED_USD=0.30
MERC_CONTROL_PLANE_PER_TASK_USD=0.0001
MERC_TARGET_MARGIN_BPS=1000

POSTGRES_PASSWORD=replace-with-random-password
MINIO_ROOT_USER=replace-with-random-access-key
MINIO_ROOT_PASSWORD=replace-with-random-secret
S3_PUBLIC_ENDPOINT=https://storage.mercmerc.net
MERC_PUBLIC_CONTROL_ORIGIN=https://mercmerc.net
SITE_HOST=mercmerc.net
STORAGE_HOST=storage.mercmerc.net
ACME_EMAIL=ops@example.com

# Backups must leave the deployment host. Use an independent S3-compatible
# bucket and restricted credentials; do not reuse the live artifact-store keys.
# Schedule with ops/systemd/merc-backup.{service,timer} (daily ~03:15 UTC).
# MERC_BACKUP_OFFSITE=s3://merc-backups/production
# MERC_BACKUP_S3_ENDPOINT=https://s3.example.com
# AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret
# MERC_BACKUP_ENCRYPTION_RECIPIENT=age1...
# MERC_BACKUP_DECRYPTION_IDENTITY_FILE=/run/secrets/merc-backup-age-identity
# MERC_BACKUP_KEEP_LOCAL=7
# Shared with the control container (docker-compose.prod.yml mounts this dir).
# MERC_BACKUP_STATUS_FILE=/var/lib/computexchange/backup-health/last-successful-offsite-backup.unixtime
# MERC_BACKUP_HEALTH_DIR=/var/lib/computexchange/backup-health

# Observability (docker-compose.observability.yml). Required — deploy refuses
# to start Alertmanager without a real HTTPS receiver URL file.
# MERC_ALERT_RECEIVER_URL_FILE=/run/secrets/cx_alert_receiver_url
# GF_SECURITY_ADMIN_PASSWORD=replace-with-at-least-32-random-bytes


# Exact-candidate human approval and exercise receipt bundle. See the schema;
# keep the filled receipt outside git and provide only its absolute path.
# GOVERNANCE_APPROVAL_BUNDLE_PATH=/absolute/private/governance-approval-bundle.json

# Operator management CIDRs. REQUIRED in production: the control plane refuses to
# start without it, and admin routes are denied outside these ranges. Comma
# separated, e.g. 203.0.113.4/32,198.51.100.0/24
MERC_ADMIN_CIDRS=127.0.0.1/32
