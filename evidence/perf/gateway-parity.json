    "fixes_applied": [
      {
        "change": "skip exact-reuse lookup for stream:true",
        "why": "cache stores non-stream JSON; looking it up on every stream request was both a correctness footgun and a TTFT-path DB round-trip",
        "risk": "low \u2014 stream clients never received a valid reuse hit before either"
      },
      {
        "change": "move maybeStoreRealtimeExactResult after Write on non-stream path",
        "why": "S3 put + DB insert was gating the buyer response after settlement already succeeded; cache is explicitly best-effort",
        "risk": "low \u2014 failure already only logged; detached 10s timeout"
      },
      {
        "change": "decodeRealtimePayload uses bytes.NewReader instead of string(body) copy",
        "why": "avoid an extra full-body allocation on every cache lookup/store",
        "risk": "none"
      },
      {
        "change": "MERC_REALTIME_PATH_TIMING=1 stage clock",
        "why": "make the next measurement print where time went without a rebuild",
        "risk": "none when unset (zero overhead beyond one getenv)"
      }
    ],
    "deliberately_not_fixed": [
      {
        "item": "AuthorizeRealtimeContract synchronous DB transaction on every request",
        "why_leave": "buyer balance FOR UPDATE + sequence reservation + contract insert are the money path; moving them off-path would relax no-duplicate-billing / no-double-payout guarantees",
        "cost": "~1.5\u20133 ms p50 on local Postgres, dominates merc-owned TTFT"
      },
      {
        "item": "settlement after stream is still synchronous on the handler goroutine",
        "why_leave": "does not affect client-visible TTFT/ITL (stream already flushed); async settlement needs careful failure accounting and is not a small safe change",
        "cost": "~2\u20134 ms after last token"
      },
      {
        "item": "per-event JSON Unmarshal + sha256 hash chain in proxySSE",
        "why_leave": "required for stream_root_sha256 / output_commitment and usage reconciliation; measured ITL overhead is ~0 within noise, so the CPU cost is not the gateway tax",
        "cost": "sub-millisecond per event at this token rate"
      },
      {
        "item": "non-stream path still settles before Write",
        "why_leave": "delivering unpaid JSON on settlement failure is a product decision; stream already has post-delivery settlement, unifying them is larger than this pass",
        "cost": "settlement latency on non-stream total wall only"
      },
      {
        "item": "OperationalControlPaused DB read every request",
        "why_leave": "caching with TTL could delay a kill-switch by that TTL; ~0.15 ms is not worth weakening intake control",
        "cost": "~0.1\u20130.3 ms"
      }
    ]
